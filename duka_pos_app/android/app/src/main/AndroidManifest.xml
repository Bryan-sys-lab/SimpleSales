<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dukapos.simplepos">
    
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Camera barcode scanning (mobile_scanner / CameraX + ML Kit). Declared
         maxSdkVersion-free because a till is expected to keep working on old
         handsets; the runtime prompt is only ever raised when the owner
         actually opens the scanner. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- A camera is optional: a shop with a wedge scanner and no camera must
         still install the app. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>

    <!-- Bluetooth thermal printing.
         - BLUETOOTH_SCAN is what discovers paired printers on Android 12+.
           `neverForLocation` is a promise that this app derives no location from
           a Bluetooth result, which is true — it only reads a device address.
         - BLUETOOTH_CONNECT is what opens the RFCOMM link, and on API 31+ it
           is a *runtime* permission the owner has to grant.
         - The legacy pair is capped at API 30 because it is silently ignored
           above it, and declaring an ignored permission is noise.
         - NFC is not requested: some receipt printers advertise NFC and a
           blanket NFC permission on a till is a liability, not a feature. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30"/>
    <uses-feature android:name="android.hardware.bluetooth" android:required="false"/>

    <!-- Package visibility, Android 11+.
         Without this, Bluetooth device discovery returns an empty list and a
         till with a perfectly good printer paired to it reports "no printers
         found". This app only ever reads a bonded-device list, so the query is
         for the local Bluetooth stack and nothing else.

         This element must be a direct child of the manifest element and must
         come before the application element. Nesting it inside the application
         element - which is where it reads most naturally, beside the code that
         needs it - is rejected by AAPT at resource-linking time with
         "unexpected element queries".

         That is a resource-linking failure rather than a Dart one, so neither
         `flutter analyze` nor `flutter test` can see it; only an actual APK
         build can. test/manifest_test.dart asserts the placement so the mistake
         costs a second locally instead of a CI run.

         The wording above deliberately avoids quoting element names verbatim:
         a comment containing literal tags makes this file ambiguous to any
         check that greps for those names. -->
    <queries>
        <intent>
            <action android:name="android.bluetooth.device.action.BOND_STATE_CHANGED"/>
        </intent>
    </queries>

    <!-- Letting the OS install an APK this app downloaded.
         Needed only FROM API 26, which is why the floor is 26 and there is no
         ceiling: below API 26 the permission does not exist and the user
         granted "unknown sources" as a global setting, so there is nothing to
         declare.

         The direction of that bound is load-bearing and was previously
         inverted. `maxSdkVersion="25"` declared the permission for the devices
         that do NOT enforce it and withheld it from every device that does:
         Android 8.0 and up, which is effectively all of them. The in-app
         updater's `canRequestPackageInstalls()` then answered false on every
         modern handset and the updater could never install anything — a
         feature that looked present in the code and was dead in the field. -->

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        android:minSdkVersion="26"/>

    <application
        android:label="SimpleSales"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <!-- The hand-off that makes an in-app update possible at all from API
             24, where a `file://` URI handed to another app throws
             FileUriExposedException. A FileProvider is the supported
             replacement.

             MUST sit inside the application element: a `provider` is only valid
             there, and at manifest level it is rejected by AAPT at
             resource-linking time — which neither `flutter analyze` nor
             `flutter test` can see, only an APK build.

             This is what lets a till update WITHOUT being uninstalled: the
             package manager treats the install as an update of an existing
             package, so the app's own data directory — the shop's whole ledger
             — survives. An uninstall would delete it. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths"/>
        </provider>

        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
              
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        
        <!-- OIDC/AppAuth callback for the public mobile client.

             NOTE: a custom scheme is hijackable. Any other app on the handset
             can register dukapos:// and be handed the authorization code
             instead of this app, because Android resolves custom schemes by
             asking which installed app claims it.

             android:autoVerify is deliberately NOT set here: it is ignored for
             non-http(s) schemes, so it would look like a fix while changing
             nothing. The real mitigation is to move this callback to a verified
             https App Link, which needs a domain this shop controls plus a
             /.well-known/assetlinks.json naming this app's release certificate.
             See .github/RELEASING.md ("OIDC callback verification"). -->
        <activity android:name="net.openid.appauth.RedirectUriReceiverActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dukapos" android:host="callback" />
            </intent-filter>
        </activity>
        
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
