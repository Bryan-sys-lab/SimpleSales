{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "duka-pos-backend",
  "main": "worker.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "BackendContainer",
      "image": "../Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-1",
      "max_instances": 1,
      "observability": { "enabled": true }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "BACKEND_CONTAINER", "class_name": "BackendContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BackendContainer"] }
  ],
  "secrets": {
    "required": [
      "DATABASE_URL", "OIDC_ISSUER_URL", "OIDC_AUDIENCE", "OIDC_JWKS_URI",
      "PUBLIC_API_URL", "PAYHERO_AUTH_TOKEN", "PAYHERO_ACCOUNT_ID",
      "MPESA_CALLBACK_KEY", "SYSTEM_ADMIN_SUBJECTS", "R2_ENDPOINT", "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY", "R2_BUCKET_NAME", "R2_PUBLIC_URL",
      "TAX_ENTITY_ENCRYPTION_KEY", "TAX_REPORTING_ACTIVATED", "RISITI_BASE_URL",
      "RISITI_API_KEY", "APP_VERSION_NAME", "APP_VERSION_CODE", "APP_DOWNLOAD_URL",
      "APP_UPDATE_REQUIRED", "APP_RELEASE_NOTES"
    ]
  }
}
