# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/duka_pos?schema=public"

# Custom auth (JWT HS256). Generate with: openssl rand -base64 48
AUTH_JWT_SECRET=
AUTH_JWT_SECRET_PREVIOUS=

# Comma-separated User.id values granted system-admin access.
# Bootstrap: create an account first, then read the userId from /auth/me.
SYSTEM_ADMIN_SUBJECTS=

# --- Identity verification (the till's "Verify" button) -----------------------
# HMAC key for verification codes and admin PINs. openssl rand -base64 48
EMAIL_VERIFICATION_SECRET=

# Cloudflare Email Service. The API token is the half that must never ship in the app.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Sender address, must be on a domain onboarded to Cloudflare Email Sending.
CLOUDFLARE_EMAIL_FROM=security@nerva.co.ke

# Local development only: return the code in the /auth/link response so a
# developer without an EmailJS template can complete the flow. Refused in
# production regardless of this value.
VERIFICATION_DEBUG_CODES=false
APP_NAME=SimpleSales

# PayHero (keep your existing credentials)
PAYHERO_AUTH_TOKEN=Basic your_base64_token
PAYHERO_BASE_URL=https://backend.payhero.co.ke/api/v2
MPESA_CALLBACK_KEY=

# URLs
# FRONTEND_URL = the web app origin allowed by CORS (not the mobile app).
FRONTEND_URL=https://your-frontend.com
# PUBLIC_API_URL = this backend's own public URL (the Worker URL).
PUBLIC_API_URL=https://api.example.com

# --- KRA eTIMS (OSCU) -------------------------------------------------------
KRA_BASE_URL=https://etims-api.kra.go.ke/etims-api
KRA_USE_SANDBOX=false
KRA_USERNAME=
KRA_PASSWORD=
KRA_TIMEOUT_MS=15000

# App update manifest (GitHub releases)
APP_VERSION_NAME=2.0.0
APP_VERSION_CODE=23
APP_DOWNLOAD_URL=
APP_UPDATE_REQUIRED=false
APP_RELEASE_NOTES=
APP_RELEASE_REPOSITORY=Bryan-sys-lab/SimpleSales

# R2 / Tax / Risiti — optional, leave blank if unused
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
TAX_REPORTING_ACTIVATED=false
TAX_REPORTING_PROVIDER=risiti
RISITI_BASE_URL=https://sandbox-api.getrisiti.com/v1/platform
RISITI_API_KEY=
TAX_ENTITY_ENCRYPTION_KEY=
