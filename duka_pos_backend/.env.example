# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/duka_pos?schema=public"

# Keycloak/OIDC JWT verification
OIDC_ISSUER_URL=https://id.example.com/realms/duka
OIDC_AUDIENCE=duka-api
OIDC_JWKS_URI=https://id.example.com/realms/duka/protocol/openid-connect/certs

# Comma-separated OIDC subject IDs. Never use email addresses here.
SYSTEM_ADMIN_SUBJECTS=

# --- Identity verification (the till's "Verify" button) -----------------------
# Creates the owner's Keycloak account from shop setup (email + 4-digit PIN),
# emails a 6-digit code, and signs the till in. All optional: without them
# /api/auth/* answers 503 rather than pretending an account was created.
#
# A confidential realm client with realm-management/manage-users. It lives here
# and nowhere else — in an APK it would be a published credential that lets
# anyone create an account for someone else's email.
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
# Only if they cannot be derived from OIDC_ISSUER_URL.
KEYCLOAK_REALM=
KEYCLOAK_BASE_URL=

# HMAC key for verification codes and admin PINs. openssl rand -base64 48
EMAIL_VERIFICATION_SECRET=

# Signs the till's session token. Delete it to revoke every outstanding
# session; rotate with APP_SESSION_SECRET_PREVIOUS to stage one.
APP_SESSION_SECRET=
APP_SESSION_SECRET_PREVIOUS=

# Cloudflare Email Service. The API token is the half that must never ship in the app.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Sender address, must be on a domain onboarded to Cloudflare Email Sending.
CLOUDFLARE_EMAIL_FROM=security@nerva.co.ke

# Local development only: return the code in the /auth/link response so a
# developer without an EmailJS template can complete the flow. Refused in
# production regardless of this value.
VERIFICATION_DEBUG_CODES=false
APP_NAME=SimpleSales

# PayHero (keep your existing credentials)
PAYHERO_AUTH_TOKEN=Basic your_base64_token
PAYHERO_BASE_URL=https://backend.payhero.co.ke/api/v2

# Optional: For production
FRONTEND_URL=https://your-frontend.com
PUBLIC_API_URL=https://api.example.com

# --- KRA eTIMS (OSCU) -------------------------------------------------------
# KRA's own hosts, not a third-party aggregator's REST API — the three look
# similar in search results and are entirely different contracts.
KRA_BASE_URL=https://etims-api.kra.go.ke/etims-api
# Sandbox: https://etims-api-sbx.kra.go.ke
KRA_USE_SANDBOX=false
# The taxpayer's KRA account. Needed for the bearer token every OSCU call
# carries. Without these, no receipt can be issued at all.
KRA_USERNAME=
KRA_PASSWORD=
# A till is blocked on this while waiting to close a sale, so it is short.
KRA_TIMEOUT_MS=15000

# eTIMS signing keys are NOT environment variables. They are issued per taxpayer
# by KRA at device initialisation and stored against the shop in `etims_devices`.
# One deployment serves many shops; putting the keys here would file every
# shop's receipts under one taxpayer.
