# ============================================================================
# Duka POS Backend - Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# REQUIRED for local development and CI/CD.
# WARNING: Replace all placeholder passwords with strong, unique values.
# ============================================================================

# ---------------------------------------------------------------
# Application
# ---------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------
DATABASE_URL=postgresql://duka_pos:[REDACTED]@localhost:5432/duka_pos

# ---------------------------------------------------------------
# Keycloak (OIDC Identity Provider)
# ---------------------------------------------------------------
OIDC_ISSUER_URL=http://localhost:8080/realms/duka
OIDC_AUDIENCE=duka-api
OIDC_JWKS_URI=http://localhost:8080/realms/duka/protocol/openid-connect/certs

# Keycloak Admin (for keycloak-init service)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=[REDACTED]

# Keycloak Realm / Client / Test User
REALM_NAME=duka
CLIENT_ID=duka-app
TEST_USER=test-user
TEST_USER_PASSWORD=[REDACTED]
TEST_USER_EMAIL=test-user@example.com

# ---------------------------------------------------------------
# PayHero (M-Pesa Payments)
# ---------------------------------------------------------------
PAYHERO_AUTH_TOKEN=payhero_live_token_2024

# ---------------------------------------------------------------
# System Admin (OIDC subjects with system admin access)
# ---------------------------------------------------------------
SYSTEM_ADMIN_SUBJECTS=admin-subject

# ---------------------------------------------------------------
# CORS (Allowed frontend origins)
# ---------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------
# App Version / Auto-Update
# ---------------------------------------------------------------
APP_VERSION_NAME=2.0.0
APP_VERSION_CODE=23
APP_DOWNLOAD_URL=https://cdn.duka-pos.example.com/app.apk
APP_UPDATE_REQUIRED=false
APP_RELEASE_NOTES=Auto-update manifest

# ---------------------------------------------------------------
# Cloudflare R2 (Profile Photos Only)
# All other images (receipts, products, docs) stay on user's device.
# ---------------------------------------------------------------
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_BUCKET_NAME=duka-pos-profile-photos
R2_PUBLIC_URL=https://pub-<account-id>.r2.dev
