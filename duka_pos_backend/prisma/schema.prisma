// Prisma schema translating your existing Supabase SQL schema
// Maintains same multi-tenant structure with RLS concepts enforced in app code

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Your existing tables from 0001_schema.sql

enum UserRole {
  admin
  manager
  cashier
}

model Tenant {
  id                  String   @id @default(uuid())
  shopName            String   @map("shop_name")
  createdAt           DateTime @default(now()) @map("created_at")
  mpesaEnabled        Boolean  @default(false) @map("mpesa_enabled")
  etimsEnabled        Boolean  @default(false) @map("etims_enabled")
  payheroChannelId    Int?     @map("payhero_channel_id")
  payheroCredentialId String?  @map("payhero_credential_id")

  profiles         Profile[]
  products         Product[]
  sales            Sale[]
  stockAdjustments StockAdjustment[]
  payments         Payment[]
  deletionLedgers  DeletionLedger[]

  @@map("tenants")
}

model Profile {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  oidcSubject String?   @map("oidc_subject")
  localId     Int?      @map("local_id")
  email       String?
  name        String
  role        UserRole  @default(cashier)
  active      Boolean   @default(true)
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales            Sale[]
  stockAdjustments StockAdjustment[]
  payments         Payment[]

  @@unique([tenantId, localId])
  @@index([tenantId])
  @@index([oidcSubject])
  @@map("profiles")
}

model Product {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  name             String
  category         String   @default("General")
  costPrice        Decimal  @map("cost_price") @db.Decimal(12, 2)
  sellPrice        Decimal  @map("sell_price") @db.Decimal(12, 2)
  stockQty         Decimal  @default(0) @map("stock_qty") @db.Decimal(12, 3)
  reorderLevel     Int      @default(5) @map("reorder_level")
  bottleMl         Int      @default(750) @map("bottle_ml")
  halfPrice        Decimal? @map("half_price") @db.Decimal(12, 2)
  quarterPrice     Decimal? @map("quarter_price") @db.Decimal(12, 2)
  exciseStampBatch String?  @map("excise_stamp_batch")
  active           Boolean  @default(true)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleItems        SaleItem[]
  stockAdjustments StockAdjustment[]

  @@index([tenantId])
  @@map("products")
}

model Sale {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  staffId          String   @map("staff_id")
  staffName        String   @map("staff_name")
  paymentMethod    String   @default("cash") @map("payment_method")
  paymentReference String?  @map("payment_reference")
  total            Decimal  @db.Decimal(12, 2)
  profit           Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff     Profile    @relation(fields: [staffId], references: [id])
  saleItems SaleItem[]
  payment   Payment?

  @@index([tenantId, createdAt])
  @@map("sales")
}

model SaleItem {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  saleId      String  @map("sale_id")
  productId   String  @map("product_id")
  productName String  @map("product_name")
  qty         Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  unitCost    Decimal @map("unit_cost") @db.Decimal(12, 2)
  portion     String  @default("full")
  portionMl   Int     @default(0) @map("portion_ml")

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@map("sale_items")
}

model StockAdjustment {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  productId   String   @map("product_id")
  productName String   @map("product_name")
  delta       Int
  reason      String?
  staffId     String   @map("staff_id")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  staff   Profile @relation(fields: [staffId], references: [id])

  @@index([tenantId])
  @@map("stock_adjustments")
}

model Payment {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  initiatedBy       String   @map("initiated_by")
  staffName         String   @map("staff_name")
  reference         String   @unique
  checkoutRequestId String?  @map("checkout_request_id")
  phoneNumber       String   @map("phone_number")
  amount            Decimal  @db.Decimal(12, 2)
  status            String   @default("QUEUED")
  cartSnapshot      Json     @map("cart_snapshot")
  saleId            String?  @unique @map("sale_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  tenant             Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  initiatedByProfile Profile @relation(fields: [initiatedBy], references: [id])
  sale               Sale?   @relation(fields: [saleId], references: [id])

  @@index([tenantId])
  @@index([reference])
  @@map("payments")
}

model DeletionLedger {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  subjectType String    @map("subject_type")
  subjectId   String    @map("subject_id")
  reason      String?
  status      String    @default("COMPLETED")
  requestedAt DateTime  @default(now()) @map("requested_at")
  completedAt DateTime? @map("completed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, subjectType, subjectId])
  @@map("deletion_ledger")
}
