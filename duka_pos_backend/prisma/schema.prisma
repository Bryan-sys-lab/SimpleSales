model Product {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  remoteId String? @map("remote_id")
  /// Stable client key makes a retried offline product create idempotent.
  syncKey  String? @map("sync_key")

  name      String
  category  String  @default("General")
  costPrice Decimal @default(0) @map("cost_price")

  sellPrice Decimal @default(0) @map("sell_price")

  stockQty Decimal @default(0) @map("stock_qty")

  reorderLevel Int @default(0) @map("reorder_level")

  bottleMl Int @default(750) @map("bottle_ml")

  unit    String  @default("each")
  mlPerKg Decimal @default(0) @map("ml_per_kg")

  productUuid          String?  @map("product_uuid")
  itemKind             String   @default("unknown") @map("item_kind")
  gpcCode              String?  @map("gpc_code")
  gpcVersion           String?  @map("gpc_version")
  gpcMappingStatus     String   @default("unmapped") @map("gpc_mapping_status")
  gtin                 String?
  merchantSku          String?  @map("merchant_sku")
  brandEntityId        String?  @map("brand_entity_id")
  brandLabelLocal      String?  @map("brand_label_local")
  manufacturerEntityId String?  @map("manufacturer_entity_id")
  variantAttributes    Json?    @map("variant_attributes")
  externalUnitCode     String?  @map("external_unit_code")
  unitScheme           String?  @map("unit_scheme")
  unitVersion          String?  @map("unit_version")
  unitMappingStatus    String   @default("unknown") @map("unit_mapping_status")
  packQuantity         Decimal? @map("pack_quantity")
  packUnitCode         String?  @map("pack_unit_code")
  identityProvenance   String   @default("system_derived") @map("identity_provenance")

  halfPrice Decimal? @map("half_price")

  quarterPrice Decimal? @map("quarter_price")

  exciseStampBatch String? @map("excise_stamp_batch")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  stockAdjustments StockAdjustment[]
  saleItems        SaleItem[]
  productVariants  ProductVariant[]

  @@unique([tenantId, syncKey])
  @@unique([tenantId, productUuid])
  @@index([tenantId])
  @@index([itemKind, gpcMappingStatus])
  @@map("products")
}

model Sale {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  /// The till's local sale id is the idempotency key for offline retries.
  localId Int? @map("local_id")

  /// Persistent till identity makes local integer ids safe across devices.
  deviceId String @default("legacy") @map("device_id")

  staffId String @map("staff_id")

  staffName String @map("staff_name")

  /// Buyer identity captured on the sale document, not read from a mutable
  /// customer directory during a later offline retry.
  buyerName String? @map("buyer_name")
  buyerTin  String? @map("buyer_tin")

  paymentMethod String @default("cash") @map("payment_method")

  paymentReference String? @map("payment_reference")

  total     Decimal  @default(0)
  profit    Decimal  @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  profile      Profile?      @relation("ProfileSales", fields: [staffId], references: [id])
  items        SaleItem[]
  salePayments SalePayment[]
  evidence    SaleEvidence[]

  @@unique([tenantId, deviceId, localId])
  @@index([tenantId])
  @@index([createdAt])
  @@map("sales")
}

/// Metadata for sale-evidence photographs. The binary remains in R2; this row
/// is the tenant-scoped, exportable link between a sale and its object.
model SaleEvidence {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  saleId    String?  @map("sale_id")
  deviceId  String   @default("legacy") @map("device_id")
  localId   Int      @map("local_id")
  objectKey String   @map("object_key")
  publicUrl String?  @map("public_url")
  mimeType  String   @map("mime_type")
  byteSize  Int?     @map("byte_size")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale   Sale?  @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@unique([tenantId, deviceId, localId, objectKey])
  @@index([tenantId, deviceId, localId])
  @@map("sale_evidence")
}

/// The append-only tender ledger for an offline sale. Keeping this separate
/// from Sale.paymentMethod preserves the legacy summary while allowing a
/// split sale to remain visible in multishop payment-mix reports.
model SalePayment {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  saleId    String   @map("sale_id")
  localUuid String   @map("local_uuid")
  method    String
  amount    Decimal
  tendered  Decimal?
  change    Decimal?
  reference String?
  status    String   @default("confirmed")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, localUuid])
  @@index([tenantId, saleId])
  @@map("sale_payments")
}

model SaleItem {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  saleId String @map("sale_id")

  productId String? @map("product_id")

  productName String @map("product_name")

  qty       Decimal
  unitPrice Decimal @map("unit_price")

  unitCost Decimal @map("unit_cost")

  // Snapshots from the till. Nullable keeps legacy uploads readable; reports
  // fall back to the historical gross line amount when these are absent.
  vatAmount      Decimal? @map("vat_amount")
  taxableAmount  Decimal? @map("taxable_amount")
  taxClass       String?  @map("tax_class")
  vatRateBps     Int?     @map("vat_rate_bps")
  taxRuleId      String?  @map("tax_rule_id")
  taxRuleVersion Int?     @map("tax_rule_version")

  portion   String @default("full")
  portionMl Int    @default(0) @map("portion_ml")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  sale    Sale     @relation(fields: [saleId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
  taxRule TaxRule? @relation(fields: [taxRuleId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([saleId])
  @@index([taxRuleId])
  @@map("sale_items")
}

model StockAdjustment {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  productId String @map("product_id")

  delta   Decimal
  reason  String?
  staffId String? @map("staff_id")

  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  product Product  @relation(fields: [productId], references: [id])
  profile Profile? @relation("ProfileStockAdjustments", fields: [staffId], references: [id])

  @@index([tenantId])
  @@map("stock_adjustments")
}

model Payment {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  initiatedBy String @map("initiated_by")

  staffName String @map("staff_name")

  reference   String @unique
  phoneNumber String @map("phone_number")

  amount       Decimal
  cartSnapshot Json    @map("cart_snapshot")

  status            String  @default("QUEUED")
  checkoutRequestId String? @map("checkout_request_id")
  paymentMode      String  @default("stk") @map("payment_mode")
  qrCodeData       String? @map("qr_code_data")
  providerStatus    String? @map("provider_status")
  providerReference String? @map("provider_reference")
  providerCheckedAt DateTime? @map("provider_checked_at")
  operationId       String?  @unique @map("operation_id")

  saleId String? @map("sale_id")

  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  profile Profile? @relation("ProfilePayments", fields: [initiatedBy], references: [id])

  @@index([tenantId])
  @@index([reference])
  @@map("payments")
}

model PayHeroChannelRegistration {
  fingerprint   String   @id
  tenantId      String?  @map("tenant_id")
  channelType   String   @map("channel_type")
  shortCode     String   @map("short_code")
  accountNumber String   @default("") @map("account_number")
  status        String   @default("REGISTERING")
  channelId     Int?     @unique @map("channel_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("payhero_channel_registrations")
}

model DeletionLedger {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  subjectType String @map("subject_type")

  subjectId String @map("subject_id")

  reason      String?
  completedAt DateTime @default(now()) @map("completed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("deletion_ledgers")
}

