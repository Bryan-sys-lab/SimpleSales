// Duka POS Prisma Schema
// Run: npx prisma generate

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

model Tenant {
  id       String @id @default(cuid())
  shopName String @map("shop_name")

  /// One of drinks, duka, fashion, open. Legacy tenants default to duka.
  businessProfile String @default("duka") @map("business_profile")

  mpesaEnabled Boolean @default(false) @map("mpesa_enabled")

  etimsEnabled Boolean @default(false) @map("etims_enabled")

  taxProvider      String  @default("risiti") @map("tax_provider")
  risitiMerchantId String? @map("risiti_merchant_id")

  payheroChannelId Int? @map("payhero_channel_id")

  payheroCredentialId String? @map("payhero_credential_id")
  payheroChannelType String? @map("payhero_channel_type")
  payheroChannelShortCode String? @map("payhero_channel_short_code")
  payheroChannelAccountNumber String? @map("payhero_channel_account_number")

  /// Safaricom Dynamic QR configuration. These are populated from the
  /// registered till/paybill channel; bank channels do not support this QR
  /// contract.
  mpesaQrCpi      String? @map("mpesa_qr_cpi")
  mpesaQrTrxCode  String? @map("mpesa_qr_trx_code")

  tin       String?
  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  profiles               Profile[]
  products               Product[]
  productVariants        ProductVariant[]
  sales                  Sale[]
  saleEvidence           SaleEvidence[]
  salePayments           SalePayment[]
  saleItems              SaleItem[]
  stockAdjustments       StockAdjustment[]
  payments               Payment[]
  payHeroChannelRegistrations PayHeroChannelRegistration[]
  deletionLedgers        DeletionLedger[]
  verificationChallenges VerificationChallenge[]
  appSessions            AppSession[]
  etimsDevices           EtimsDevice[]
  etimsReceipts          EtimsReceipt[]
  etimsZReports          EtimsZReport[]
  mpesaIncoming          MpesaIncoming[]
  receiptLinks           ReceiptLink[]
  telemetryEvents        TelemetryEvent[]        @relation("TenantTelemetryEvents")
  churnSnapshots         ChurnSnapshot[]         @relation("TenantChurnSnapshots")
  supportTickets         SupportTicket[]
  cloudBackups           CloudBackup[]
  customers              Customer[]
  creditLedger           CreditLedger[]
  syncRecords            SyncRecord[]
  saleSyncConflicts      SaleSyncConflict[]
  taxEntityLinks         ShopTaxEntity[]
  costPools              CostPool[]
  deviceDiagnostics      DeviceDiagnostic[]
  subscription           TenantSubscription?
  subscriptionPayments   SubscriptionPayment[]
  accessVouchers         AccessVoucher[]
  membershipRequests     MembershipRequest[]
  membershipAgreements   MembershipAgreement[]
  businessContext        BusinessContext?
  commercialConsentGrants CommercialConsentGrant[]

  ownerTransactions      OwnerTransaction[]

  @@map("tenants")
}

/// Operational classification details supplied by a shop owner. This record
/// is tenant scoped and is never a commercial contribution or consent record.
model BusinessContext {
  id                      String   @id @default(cuid())
  tenantId                String   @unique @map("tenant_id")
  appProfile              String   @map("app_profile")
  primaryActivityCode     String?  @map("primary_activity_code")
  primaryActivityStatus   String   @default("pending") @map("primary_activity_status")
  activityScheme          String?  @map("activity_scheme")
  activityVersion         String?  @map("activity_version")
  secondaryActivityCodes  Json     @default("[]") @map("secondary_activity_codes")
  operatorRoles           Json     @default("[]") @map("operator_roles")
  salesChannels           Json     @default("[]") @map("sales_channels")
  countyCode              String?  @map("county_code")
  settlementContext       String   @default("unknown") @map("settlement_context")
  fieldProvenance         Json     @default("{}") @map("field_provenance")
  confirmedAt             DateTime? @map("confirmed_at")
  schemaVersion           Int      @default(1) @map("schema_version")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([primaryActivityCode])
  @@map("business_context")
}

/// Tax registration belongs to the taxpayer, not to a profile preset or one
/// outlet. A taxpayer may operate several shops under one entity.
model TaxEntity {
  id                         String   @id @default(cuid())
  legalForm                  String   @map("legal_form")
  displayLabel               String   @map("display_label")
  kraPinCiphertext           String?  @map("kra_pin_ciphertext")
  kraPinLast4                String?  @map("kra_pin_last4")
  registeredTaxObligations   Json     @default("[]") @map("registered_tax_obligations")
  accountingPeriodStartMonth Int      @default(1) @map("accounting_period_start_month")
  status                     String   @default("needs_review")
  etimsOnboardingStatus      String   @default("not_started") @map("etims_onboarding_status")
  etimsMethod                String?  @map("etims_method")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  shops           ShopTaxEntity[]
  taxRules        TaxRule[]
  vatReturns      VatReturn[]
  totReturns      TotReturn[]
  taxReturnEvents TaxReturnEvent[]

  @@map("tax_entities")
}

/// Prepared VAT-period evidence. A prepared record is not a KRA submission;
/// status transitions are explicit so accepted/rejected/settled cannot be
/// inferred from the presence of an export.
model VatReturn {
  id                   String    @id @default(cuid())
  taxEntityId          String    @map("tax_entity_id")
  periodStart          DateTime  @map("period_start")
  periodEnd            DateTime  @map("period_end")
  outputVat            Decimal   @default(0) @map("output_vat")
  eligibleInputVat     Decimal   @default(0) @map("eligible_input_vat")
  withholdingVatCredit Decimal   @default(0) @map("withholding_vat_credit")
  adjustments          Decimal   @default(0)
  netPayable           Decimal   @default(0) @map("net_payable")
  evidence             Json      @default("{}")
  status               String    @default("prepared")
  submittedAt          DateTime? @map("submitted_at")
  acceptedAt           DateTime? @map("accepted_at")
  paidAt               DateTime? @map("paid_at")
  rejectionReason      String?   @map("rejection_reason")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  taxEntity TaxEntity        @relation(fields: [taxEntityId], references: [id], onDelete: Cascade)
  events    TaxReturnEvent[]

  @@unique([taxEntityId, periodStart, periodEnd])
  @@index([taxEntityId, periodStart, periodEnd])
  @@index([status])
  @@map("vat_returns")
}

/// Indicative/period TOT evidence. This is deliberately separate from VAT:
/// expenses are not deducted from its gross-sales base.
model TotReturn {
  id              String    @id @default(cuid())
  taxEntityId     String    @map("tax_entity_id")
  periodStart     DateTime  @map("period_start")
  periodEnd       DateTime  @map("period_end")
  grossSales      Decimal   @default(0) @map("gross_sales")
  rateBasisPoints Int?      @map("rate_basis_points")
  estimate        Decimal   @default(0)
  evidence        Json      @default("{}")
  status          String    @default("prepared")
  submittedAt     DateTime? @map("submitted_at")
  acceptedAt      DateTime? @map("accepted_at")
  paidAt          DateTime? @map("paid_at")
  rejectionReason String?   @map("rejection_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  taxEntity TaxEntity        @relation(fields: [taxEntityId], references: [id], onDelete: Cascade)
  events    TaxReturnEvent[]

  @@unique([taxEntityId, periodStart, periodEnd])
  @@index([taxEntityId, periodStart, periodEnd])
  @@index([status])
  @@map("tot_returns")
}

/// Append-only audit trail for tax-return status transitions. The current
/// return row is a queryable projection; this ledger preserves the history.
model TaxReturnEvent {
  id          String   @id @default(cuid())
  taxEntityId String   @map("tax_entity_id")
  vatReturnId String?  @map("vat_return_id")
  totReturnId String?  @map("tot_return_id")
  fromStatus  String?  @map("from_status")
  toStatus    String   @map("to_status")
  actorId     String   @map("actor_id")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  taxEntity TaxEntity  @relation(fields: [taxEntityId], references: [id], onDelete: Cascade)
  vatReturn VatReturn? @relation(fields: [vatReturnId], references: [id], onDelete: Cascade)
  totReturn TotReturn? @relation(fields: [totReturnId], references: [id], onDelete: Cascade)

  @@index([taxEntityId, createdAt])
  @@index([vatReturnId, createdAt])
  @@index([totReturnId, createdAt])
  @@map("tax_return_events")
}

/// Effective-dated outlet relationship. Historical links remain auditable;
/// only one link may be active for a shop at a given time in application logic.
model ShopTaxEntity {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  taxEntityId     String    @map("tax_entity_id")
  outletReference String?   @map("outlet_reference")
  effectiveFrom   DateTime  @map("effective_from")
  effectiveTo     DateTime? @map("effective_to")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taxEntity TaxEntity @relation(fields: [taxEntityId], references: [id], onDelete: Cascade)

  @@index([tenantId, effectiveFrom, effectiveTo])
  @@index([taxEntityId, effectiveFrom, effectiveTo])
  @@map("shop_tax_entities")
}

/// A reviewed, effective-dated tax rule. Rules are versioned records rather
/// than mutable constants so historical documents can retain their snapshot.
model TaxRule {
  id              String    @id @default(cuid())
  taxEntityId     String    @map("tax_entity_id")
  taxType         String    @map("tax_type")
  scope           String
  jurisdiction    String    @default("KE")
  rateBasisPoints Int?      @map("rate_basis_points")
  taxBase         String    @map("tax_base")
  filingFrequency String    @default("none") @map("filing_frequency")
  filingDueDay    Int?      @map("filing_due_day")
  thresholdMinor  Decimal?  @map("threshold_minor")
  effectiveFrom   DateTime  @map("effective_from")
  effectiveTo     DateTime? @map("effective_to")
  sourceUrl       String    @map("source_url")
  sourceReference String?   @map("source_reference")
  reviewedAt      DateTime? @map("reviewed_at")
  approvedBy      String?   @map("approved_by")
  approvalNote    String?   @map("approval_note")
  status          String    @default("needs_review")
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  taxEntity TaxEntity  @relation(fields: [taxEntityId], references: [id], onDelete: Cascade)
  saleItems SaleItem[]

  @@index([taxEntityId, taxType, scope, effectiveFrom, effectiveTo])
  @@index([status, effectiveFrom, effectiveTo])
  @@map("tax_rules")
}

/// Opaque client-encrypted workspace snapshots. The API stores ciphertext only;
/// the portable passphrase export remains the recovery path for a new phone.
model CloudBackup {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  workspaceKey String   @map("workspace_key")
  kind         String   @default("device_bound")
  snapshotHash String?  @map("snapshot_hash")
  // Legacy rows keep their ciphertext here. New rows store it in R2 and keep
  // only this object key in Postgres.
  payload      String
  storageKey   String?  @map("storage_key")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, workspaceKey, kind, createdAt])
  @@unique([tenantId, workspaceKey, kind, snapshotHash])
  @@map("cloud_backups")
}

model Partner {
  id             String   @id @default(cuid())
  legalName      String   @map("legal_name")
  status         String   @default("pending_contract")
  contractRef    String?  @map("contract_ref")
  purpose        String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  grants      PartnerGrant[]
  credentials PartnerCredential[]
  deliveries  PartnerDelivery[]

  @@map("partners")
}

model PartnerGrant {
  id             String   @id @default(cuid())
  partnerId      String   @map("partner_id")
  productId      String   @map("product_id")
  snapshotId     String   @map("snapshot_id")
  permittedScope String   @map("permitted_scope")
  status         String   @default("active")
  expiresAt      DateTime @map("expires_at")
  quotaPerDay    Int      @default(100) @map("quota_per_day")
  createdAt      DateTime @default(now()) @map("created_at")
  revokedAt      DateTime? @map("revoked_at")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  deliveries PartnerDelivery[]

  @@index([partnerId, status, expiresAt])
  @@map("partner_grants")
}

model PartnerCredential {
  id          String   @id @default(cuid())
  partnerId   String   @map("partner_id")
  keyPrefix   String   @map("key_prefix")
  keyHash     String   @unique @map("key_hash")
  status      String   @default("active")
  expiresAt   DateTime @map("expires_at")
  quotaPerDay Int      @default(100) @map("quota_per_day")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime @default(now()) @map("created_at")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, status, expiresAt])
  @@map("partner_credentials")
}

model PartnerDelivery {
  id        String   @id @default(cuid())
  partnerId String   @map("partner_id")
  grantId   String   @map("grant_id")
  snapshotId String  @map("snapshot_id")
  productId String   @map("product_id")
  status    String
  responseHash String? @map("response_hash")
  createdAt DateTime @default(now()) @map("created_at")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  grant PartnerGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
  @@map("partner_deliveries")
}

/// Server-authoritative, owner-granted commercial contribution scopes.
/// This is purpose and withdrawal evidence; it never enables collection.
model CommercialConsentGrant {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  actorId           String    @map("actor_id")
  actorRole         String    @map("actor_role")
  status            String    @default("active")
  scopes            Json
  noticeVersion     String    @map("notice_version")
  noticeDigest      String    @map("notice_digest")
  termsVersion      String?   @map("terms_version")
  schemaVersion     String    @map("schema_version")
  dictionaryVersion String    @map("dictionary_version")
  appVersion        String    @map("app_version")
  captureMethod     String    @map("capture_method")
  authorityEvidence String    @map("authority_evidence")
  effectiveAt       DateTime  @map("effective_at")
  withdrawnAt       DateTime? @map("withdrawn_at")
  processingState   String    @default("none") @map("processing_state")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, effectiveAt])
  @@map("commercial_consent_grants")
}

/// Restricted, minimized commercial contribution ledger. It deliberately has
/// no tenant/shop/customer/source-transaction foreign key: lineage is held as
/// controlled metadata and is visible only to the existing system-admin
/// surface while the commercial policy is approved.
model CommercialContribution {
  id                      String   @id @default(cuid())
  tenantId                String?  @map("tenant_id")
  batchId                 String   @map("batch_id")
  recordId                String   @unique @map("record_id")
  policyVersion           String   @map("policy_version")
  schemaVersion           String   @map("schema_version")
  businessProfile         String   @map("business_profile")
  periodStart             DateTime @map("period_start")
  periodEnd               DateTime @map("period_end")
  currency                String
  categoryFamily          String   @map("category_family")
  unitKind                String   @map("unit_kind")
  transactionCount        Int      @map("transaction_count")
  grossRevenueMinor       Int      @map("gross_revenue_minor")
  discountMinor           Int      @map("discount_minor")
  refundMinor             Int      @map("refund_minor")
  cogsMinor               Int      @map("cogs_minor")
  stockoutCount           Int      @map("stockout_count")
  paymentMethodMix        Json     @map("payment_method_mix")
  coverageLevel           String   @map("coverage_level")
  normalizedVersion       String   @map("normalized_version")
  status                  String   @default("accepted")
  consentPurposeVersion   String   @map("consent_purpose_version")
  qualityFlags            Json     @default("[]") @map("quality_flags")
  payloadChecksum         String   @map("payload_checksum")
  aggregationJobVersion   String?  @map("aggregation_job_version")
  datasetSnapshotId       String?  @map("dataset_snapshot_id")
  partnerExportRefs       Json     @default("[]") @map("partner_export_refs")
  supersedesRecordId      String?  @map("supersedes_record_id")
  retentionState          String   @default("active") @map("retention_state")
  deletedAt               DateTime? @map("deleted_at")
  acceptedAt              DateTime @default(now()) @map("accepted_at")
  createdAt               DateTime @default(now()) @map("created_at")

  @@index([businessProfile, periodStart, periodEnd])
  @@index([batchId, acceptedAt])
  @@map("commercial_contributions")
}

/// Customer and credit rows synced from an offline till. localUuid is the
/// stable client identity; server ids are deliberately opaque.
model Customer {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  localUuid        String   @map("local_uuid")
  name             String
  phone            String?
  tin              String?
  notes            String?
  creditLimitMinor Int?     @map("credit_limit_minor")
  balanceMinor     Int      @map("balance_minor")
  active           Boolean  @default(true)
  createdAt        DateTime @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creditLedger CreditLedger[]

  @@unique([tenantId, localUuid])
  @@index([tenantId, name])
  @@map("customers")
}

model CreditLedger {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  localUuid     String   @map("local_uuid")
  customerId    String   @map("customer_id")
  entryType     String   @map("entry_type")
  amountMinor   Int      @map("amount_minor")
  saleLocalId   Int?     @map("sale_local_id")
  returnLocalId Int?     @map("return_local_id")
  paymentMethod String?  @map("payment_method")
  reference     String?
  staffName     String   @map("staff_name")
  note          String?
  createdAt     DateTime @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, localUuid])
  @@index([tenantId, customerId, createdAt])
  @@map("credit_ledger")
}

/// Idempotent mirror for offline operational records whose detailed source of
/// truth remains in the till snapshot. Keeping the original payload lets the
/// portfolio and recovery tools see the record without duplicating every
/// device-local table in the server schema.
model SyncRecord {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  kind      String
  deviceId  String   @default("legacy") @map("device_id")
  localId   Int      @map("local_id")
  payload   Json
  createdAt DateTime @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, deviceId, localId])
  @@index([tenantId, kind, createdAt])
  @@map("sync_records")
}

/// A sale that lost a concurrent stock race stays auditable until a manager
/// explicitly accepts it or voids it. The payload is the original offline
/// sale, so resolving it never depends on mutable till state.
model SaleSyncConflict {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  deviceId   String    @map("device_id")
  localId    Int       @map("local_id")
  payload    Json
  reason     String
  status     String    @default("open")
  resolution String?
  resolvedBy String?   @map("resolved_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, deviceId, localId])
  @@index([tenantId, status, createdAt])
  @@map("sale_sync_conflicts")
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String    @map("password_hash")
  emailVerifiedAt    DateTime? @map("email_verified_at")
  failedLoginAttempts Int      @default(0) @map("failed_login_attempts")
  lockedUntil        DateTime? @map("locked_until")
  refreshTokenRotatedAt DateTime? @map("refresh_token_rotated_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  profiles Profile[]

  @@map("users")
}

model Profile {
  id          String  @id @default(cuid())
  userId      String? @map("user_id")

  tenantId String @map("tenant_id")

  localId Int? @map("local_id")

  name     String
  username String?
  email    String?
  photoUrl String? @map("photo_url")
  // PBKDF2 verifier supplied by an authenticated till. Plain PINs never
  // cross the API or enter the database.
  pinHash             String?   @map("pin_hash")
  pinFormat           String?   @map("pin_format") // legacy-pbkdf2 | v2-pbkdf2-sha256
  pinCredentialVersion Int      @default(0) @map("pin_credential_version")
  pinUpdatedAt        DateTime? @map("pin_updated_at")
  pinFailedAttempts   Int       @default(0) @map("pin_failed_attempts")
  pinLockedUntil      DateTime? @map("pin_locked_until")

  role      String    @default("cashier")
  active    Boolean   @default(true)
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")

  // Refresh token state (one active refresh token per profile).
  refreshTokenHash         String?   @unique @map("refresh_token_hash")
  refreshTokenPreviousHash String?   @map("refresh_token_previous_hash")
  refreshTokenExpiresAt    DateTime? @map("refresh_token_expires_at")
  refreshTokenTier         String?   @map("refresh_token_tier")
  refreshTokenRotatedAt    DateTime? @map("refresh_token_rotated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  user             User?             @relation(fields: [userId], references: [id])
  sales            Sale[]            @relation("ProfileSales")
  stockAdjustments StockAdjustment[] @relation("ProfileStockAdjustments")
  payments         Payment[]         @relation("ProfilePayments")
  issuedVouchers   AccessVoucher[]   @relation("VoucherIssuedTo")
  redeemedVouchers AccessVoucher[]   @relation("VoucherRedeemedBy")

  // Usernames are unique inside a shop; the same username may exist in a
  // different shop because the shop ID is part of the login identity.
  @@unique([tenantId, username])
  @@index([tenantId])
  @@index([userId])
  @@map("profiles")
}

model TenantSubscription {
  id                String   @id @default(cuid())
  tenantId          String   @unique @map("tenant_id")
  status            String   @default("pending")
  priceMinor        Int?     @map("price_minor")
  discountPercent   Int      @default(0) @map("discount_percent")
  currency          String   @default("KES")
  billingInterval   String   @default("monthly") @map("billing_interval")
  currentPeriodEnd  DateTime? @map("current_period_end")
  graceUntil        DateTime? @map("grace_until")
  voucherId         String?  @unique @map("voucher_id")
  agreementId       String?  @unique @map("agreement_id")
  updatedBy         String?  @map("updated_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  voucher           AccessVoucher? @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  agreement         MembershipAgreement? @relation(fields: [agreementId], references: [id], onDelete: SetNull)

  @@index([status, currentPeriodEnd])
  @@map("tenant_subscriptions")
}

model AccessVoucher {
  id                String   @id @default(cuid())
  codeHash          String   @unique @map("code_hash")
  codePrefix        String   @map("code_prefix")
  tenantId          String?  @map("tenant_id")
  issuedToProfileId String?  @map("issued_to_profile_id")
  issuedToEmail     String?  @map("issued_to_email")
  expiresAt         DateTime? @map("expires_at")
  voucherType       String   @default("access") @map("voucher_type")
  durationMonths    Int      @default(1) @map("duration_months")
  discountPercent   Int      @default(0) @map("discount_percent")
  redeemedAt        DateTime? @map("redeemed_at")
  redeemedByProfileId String? @map("redeemed_by_profile_id")
  revokedAt         DateTime? @map("revoked_at")
  pausedAt          DateTime? @map("paused_at")
  deletedAt         DateTime? @map("deleted_at")
  autoIssued        Boolean  @default(false) @map("auto_issued")
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant            Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  issuedToProfile   Profile? @relation("VoucherIssuedTo", fields: [issuedToProfileId], references: [id], onDelete: SetNull)
  redeemedByProfile Profile? @relation("VoucherRedeemedBy", fields: [redeemedByProfileId], references: [id], onDelete: SetNull)
  subscription      TenantSubscription?

  @@index([tenantId, expiresAt])
  @@index([issuedToEmail])
  @@map("access_vouchers")
}

model SubscriptionPayment {
