// Duka POS Prisma Schema
// Run: npx prisma generate

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id       String @id @default(cuid())
  shopName String @map("shop_name")

  /// One of drinks, duka, fashion, open. Legacy tenants default to duka.
  businessProfile String @default("duka") @map("business_profile")

  mpesaEnabled Boolean @default(false) @map("mpesa_enabled")

  etimsEnabled Boolean @default(false) @map("etims_enabled")

  taxProvider      String  @default("risiti") @map("tax_provider")
  risitiMerchantId String? @map("risiti_merchant_id")

  payheroChannelId Int? @map("payhero_channel_id")

  payheroCredentialId String? @map("payhero_credential_id")

  tin       String?
  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  profiles               Profile[]
  products               Product[]
  productVariants        ProductVariant[]
  sales                  Sale[]
  salePayments           SalePayment[]
  saleItems              SaleItem[]
  stockAdjustments       StockAdjustment[]
  payments               Payment[]
  deletionLedgers        DeletionLedger[]
  verificationChallenges VerificationChallenge[]
  appSessions            AppSession[]
  etimsDevices           EtimsDevice[]
  etimsReceipts          EtimsReceipt[]
  etimsZReports          EtimsZReport[]
  mpesaIncoming          MpesaIncoming[]
  receiptLinks           ReceiptLink[]
  telemetryEvents        TelemetryEvent[]        @relation("TenantTelemetryEvents")
  churnSnapshots         ChurnSnapshot[]         @relation("TenantChurnSnapshots")
  supportTickets         SupportTicket[]
  cloudBackups           CloudBackup[]
  customers              Customer[]
  creditLedger           CreditLedger[]
  syncRecords            SyncRecord[]
  saleSyncConflicts      SaleSyncConflict[]
  taxEntityLinks         ShopTaxEntity[]
  jobs                   Job[]
  costPools              CostPool[]
  jobCosts               JobCost[]
  jobPayments            JobPayment[]
  ownerTransactions      OwnerTransaction[]

  @@map("tenants")
}

/// Tax registration belongs to the taxpayer, not to a profile preset or one
/// outlet. A taxpayer may operate several shops under one entity.
model TaxEntity {
  id                         String   @id @default(cuid())
  legalForm                  String   @map("legal_form")
  displayLabel               String   @map("display_label")
  kraPinCiphertext           String?  @map("kra_pin_ciphertext") @db.Text
  kraPinLast4                String?  @map("kra_pin_last4")
  registeredTaxObligations   Json     @default("[]") @map("registered_tax_obligations")
  accountingPeriodStartMonth Int      @default(1) @map("accounting_period_start_month")
  status                     String   @default("needs_review")
  etimsOnboardingStatus      String   @default("not_started") @map("etims_onboarding_status")
  etimsMethod                String?  @map("etims_method")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  shops           ShopTaxEntity[]
  taxRules        TaxRule[]
  vatReturns      VatReturn[]
  totReturns      TotReturn[]
  taxReturnEvents TaxReturnEvent[]

  @@map("tax_entities")
}

/// Prepared VAT-period evidence. A prepared record is not a KRA submission;
/// status transitions are explicit so accepted/rejected/settled cannot be
/// inferred from the presence of an export.
model VatReturn {
  id                   String    @id @default(cuid())
  taxEntityId          String    @map("tax_entity_id")
  periodStart          DateTime  @map("period_start")
  periodEnd            DateTime  @map("period_end")
  outputVat            Decimal   @default(0) @map("output_vat")
  eligibleInputVat     Decimal   @default(0) @map("eligible_input_vat")
  withholdingVatCredit Decimal   @default(0) @map("withholding_vat_credit")
  adjustments          Decimal   @default(0)
  netPayable           Decimal   @default(0) @map("net_payable")
  evidence             Json      @default("{}")
  status               String    @default("prepared")
  submittedAt          DateTime? @map("submitted_at")
  acceptedAt           DateTime? @map("accepted_at")
  paidAt               DateTime? @map("paid_at")
  rejectionReason      String?   @map("rejection_reason") @db.Text
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  taxEntity TaxEntity        @relation(fields: [taxEntityId], references: [id], onDelete: Cascade)
  events    TaxReturnEvent[]

  @@unique([taxEntityId, periodStart, periodEnd])
  @@index([taxEntityId, periodStart, periodEnd])
  @@index([status])
  @@map("vat_returns")
}

/// Indicative/period TOT evidence. This is deliberately separate from VAT:
/// expenses are not deducted from its gross-sales base.
model TotReturn {
  id              String    @id @default(cuid())
  taxEntityId     String    @map("tax_entity_id")
  periodStart     DateTime  @map("period_start")
  periodEnd       DateTime  @map("period_end")
  grossSales      Decimal   @default(0) @map("gross_sales")
  rateBasisPoints Int?      @map("rate_basis_points")
  estimate        Decimal   @default(0)
  evidence        Json      @default("{}")
  status          String    @default("prepared")
  submittedAt     DateTime? @map("submitted_at")
  acceptedAt      DateTime? @map("accepted_at")
  paidAt          DateTime? @map("paid_at")
  rejectionReason String?   @map("rejection_reason") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  taxEntity TaxEntity        @relation(fields: [taxEntityId], references: [id], onDelete: Cascade)
  events    TaxReturnEvent[]

  @@unique([taxEntityId, periodStart, periodEnd])
  @@index([taxEntityId, periodStart, periodEnd])
  @@index([status])
  @@map("tot_returns")
}

/// Append-only audit trail for tax-return status transitions. The current
/// return row is a queryable projection; this ledger preserves the history.
model TaxReturnEvent {
  id          String   @id @default(cuid())
  taxEntityId String   @map("tax_entity_id")
  vatReturnId String?  @map("vat_return_id")
  totReturnId String?  @map("tot_return_id")
  fromStatus  String?  @map("from_status")
  toStatus    String   @map("to_status")
  actorId     String   @map("actor_id")
  note        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  taxEntity TaxEntity  @relation(fields: [taxEntityId], references: [id], onDelete: Cascade)
  vatReturn VatReturn? @relation(fields: [vatReturnId], references: [id], onDelete: Cascade)
  totReturn TotReturn? @relation(fields: [totReturnId], references: [id], onDelete: Cascade)

  @@index([taxEntityId, createdAt])
  @@index([vatReturnId, createdAt])
  @@index([totReturnId, createdAt])
  @@map("tax_return_events")
}

/// Effective-dated outlet relationship. Historical links remain auditable;
/// only one link may be active for a shop at a given time in application logic.
model ShopTaxEntity {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  taxEntityId     String    @map("tax_entity_id")
  outletReference String?   @map("outlet_reference")
  effectiveFrom   DateTime  @map("effective_from")
  effectiveTo     DateTime? @map("effective_to")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taxEntity TaxEntity @relation(fields: [taxEntityId], references: [id], onDelete: Cascade)

  @@index([tenantId, effectiveFrom, effectiveTo])
  @@index([taxEntityId, effectiveFrom, effectiveTo])
  @@map("shop_tax_entities")
}

/// A reviewed, effective-dated tax rule. Rules are versioned records rather
/// than mutable constants so historical documents can retain their snapshot.
model TaxRule {
  id              String    @id @default(cuid())
  taxEntityId     String    @map("tax_entity_id")
  taxType         String    @map("tax_type")
  scope           String
  jurisdiction    String    @default("KE")
  rateBasisPoints Int?      @map("rate_basis_points")
  taxBase         String    @map("tax_base")
  filingFrequency String    @default("none") @map("filing_frequency")
  filingDueDay    Int?      @map("filing_due_day")
  thresholdMinor  Decimal?  @map("threshold_minor")
  effectiveFrom   DateTime  @map("effective_from")
  effectiveTo     DateTime? @map("effective_to")
  sourceUrl       String    @map("source_url") @db.Text
  sourceReference String?   @map("source_reference") @db.Text
  reviewedAt      DateTime? @map("reviewed_at")
  approvedBy      String?   @map("approved_by")
  approvalNote    String?   @map("approval_note") @db.Text
  status          String    @default("needs_review")
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  taxEntity TaxEntity  @relation(fields: [taxEntityId], references: [id], onDelete: Cascade)
  saleItems SaleItem[]

  @@index([taxEntityId, taxType, scope, effectiveFrom, effectiveTo])
  @@index([status, effectiveFrom, effectiveTo])
  @@map("tax_rules")
}

/// Opaque client-encrypted workspace snapshots. The API stores ciphertext only;
/// the portable passphrase export remains the recovery path for a new phone.
model CloudBackup {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  workspaceKey String   @map("workspace_key")
  kind         String   @default("device_bound")
  snapshotHash String?  @map("snapshot_hash")
  // Legacy rows keep their ciphertext here. New rows store it in R2 and keep
  // only this object key in Postgres.
  payload      String   @db.Text
  storageKey   String?  @map("storage_key")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, workspaceKey, kind, createdAt])
  @@unique([tenantId, workspaceKey, kind, snapshotHash])
  @@map("cloud_backups")
}

/// Restricted, minimized commercial contribution ledger. It deliberately has
/// no tenant/shop/customer/source-transaction foreign key: lineage is held as
/// controlled metadata and is visible only to the existing system-admin
/// surface while the commercial policy is approved.
model CommercialContribution {
  id                      String   @id @default(cuid())
  batchId                 String   @map("batch_id")
  recordId                String   @unique @map("record_id")
  policyVersion           String   @map("policy_version")
  schemaVersion           String   @map("schema_version")
  businessProfile         String   @map("business_profile")
  periodStart             DateTime @map("period_start")
  periodEnd               DateTime @map("period_end")
  currency                String
  categoryFamily          String   @map("category_family")
  unitKind                String   @map("unit_kind")
  transactionCount        Int      @map("transaction_count")
  grossRevenueMinor       Int      @map("gross_revenue_minor")
  discountMinor           Int      @map("discount_minor")
  refundMinor             Int      @map("refund_minor")
  cogsMinor               Int      @map("cogs_minor")
  stockoutCount           Int      @map("stockout_count")
  paymentMethodMix        Json     @map("payment_method_mix")
  coverageLevel           String   @map("coverage_level")
  normalizedVersion       String   @map("normalized_version")
  status                  String   @default("accepted")
  consentPurposeVersion   String   @map("consent_purpose_version")
  qualityFlags            Json     @default("[]") @map("quality_flags")
  payloadChecksum         String   @map("payload_checksum")
  aggregationJobVersion   String?  @map("aggregation_job_version")
  datasetSnapshotId       String?  @map("dataset_snapshot_id")
  partnerExportRefs       Json     @default("[]") @map("partner_export_refs")
  supersedesRecordId      String?  @map("supersedes_record_id")
  retentionState          String   @default("active") @map("retention_state")
  deletedAt               DateTime? @map("deleted_at")
  acceptedAt              DateTime @default(now()) @map("accepted_at")
  createdAt               DateTime @default(now()) @map("created_at")

  @@index([businessProfile, periodStart, periodEnd])
  @@index([batchId, acceptedAt])
  @@map("commercial_contributions")
}

/// Customer and credit rows synced from an offline till. localUuid is the
/// stable client identity; server ids are deliberately opaque.
model Customer {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  localUuid        String   @map("local_uuid")
  name             String
  phone            String?
  tin              String?
  notes            String?
  creditLimitMinor Int?     @map("credit_limit_minor")
  balanceMinor     Int      @map("balance_minor")
  active           Boolean  @default(true)
  createdAt        DateTime @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creditLedger CreditLedger[]

  @@unique([tenantId, localUuid])
  @@index([tenantId, name])
  @@map("customers")
}

model CreditLedger {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  localUuid     String   @map("local_uuid")
  customerId    String   @map("customer_id")
  entryType     String   @map("entry_type")
  amountMinor   Int      @map("amount_minor")
  saleLocalId   Int?     @map("sale_local_id")
  returnLocalId Int?     @map("return_local_id")
  paymentMethod String?  @map("payment_method")
  reference     String?
  staffName     String   @map("staff_name")
  note          String?
  createdAt     DateTime @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, localUuid])
  @@index([tenantId, customerId, createdAt])
  @@map("credit_ledger")
}

/// Idempotent mirror for offline operational records whose detailed source of
/// truth remains in the till snapshot. Keeping the original payload lets the
/// portfolio and recovery tools see the record without duplicating every
/// device-local table in the server schema.
model SyncRecord {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  kind      String
  deviceId  String   @default("legacy") @map("device_id")
  localId   Int      @map("local_id")
  payload   Json
  createdAt DateTime @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, deviceId, localId])
  @@index([tenantId, kind, createdAt])
  @@map("sync_records")
}

/// A sale that lost a concurrent stock race stays auditable until a manager
/// explicitly accepts it or voids it. The payload is the original offline
/// sale, so resolving it never depends on mutable till state.
model SaleSyncConflict {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  deviceId   String    @map("device_id")
  localId    Int       @map("local_id")
  payload    Json
  reason     String
  status     String    @default("open")
  resolution String?
  resolvedBy String?   @map("resolved_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, deviceId, localId])
  @@index([tenantId, status, createdAt])
  @@map("sale_sync_conflicts")
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String    @map("password_hash")
  emailVerifiedAt    DateTime? @map("email_verified_at")
  failedLoginAttempts Int      @default(0) @map("failed_login_attempts")
  lockedUntil        DateTime? @map("locked_until")
  refreshTokenRotatedAt DateTime? @map("refresh_token_rotated_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  profiles Profile[]

  @@map("users")
}

model Profile {
  id          String  @id @default(cuid())
  userId      String? @map("user_id")

  tenantId String @map("tenant_id")

  localId Int? @map("local_id")

  name     String
  username String?
  email    String?
  photoUrl String? @map("photo_url")
  // PBKDF2 verifier supplied by an authenticated till. Plain PINs never
  // cross the API or enter the database.
  pinHash  String? @map("pin_hash")

  role      String    @default("cashier")
  active    Boolean   @default(true)
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")

  // Refresh token state (one active refresh token per profile).
  refreshTokenHash         String?   @unique @map("refresh_token_hash")
  refreshTokenPreviousHash String?   @map("refresh_token_previous_hash")
  refreshTokenExpiresAt    DateTime? @map("refresh_token_expires_at")
  refreshTokenTier         String?   @map("refresh_token_tier")
  refreshTokenRotatedAt    DateTime? @map("refresh_token_rotated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  user             User?             @relation(fields: [userId], references: [id])
  sales            Sale[]            @relation("ProfileSales")
  stockAdjustments StockAdjustment[] @relation("ProfileStockAdjustments")
  payments         Payment[]         @relation("ProfilePayments")

  // Usernames are unique inside a shop; the same username may exist in a
  // different shop because the shop ID is part of the login identity.
  @@unique([tenantId, username])
  @@index([tenantId])
  @@index([userId])
  @@map("profiles")
}

model Product {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  remoteId String? @map("remote_id")
  /// Stable client key makes a retried offline product create idempotent.
  syncKey  String? @map("sync_key")

  name      String
  category  String  @default("General")
  costPrice Decimal @default(0) @map("cost_price")

  sellPrice Decimal @default(0) @map("sell_price")

  stockQty Decimal @default(0) @map("stock_qty")

  reorderLevel Int @default(0) @map("reorder_level")

  bottleMl Int @default(750) @map("bottle_ml")

  unit    String  @default("each")
  mlPerKg Decimal @default(0) @map("ml_per_kg")

  halfPrice Decimal? @map("half_price")

  quarterPrice Decimal? @map("quarter_price")

  exciseStampBatch String? @map("excise_stamp_batch")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  stockAdjustments StockAdjustment[]
  saleItems        SaleItem[]
  productVariants  ProductVariant[]

  @@unique([tenantId, syncKey])
  @@index([tenantId])
  @@map("products")
}

model Sale {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  /// The till's local sale id is the idempotency key for offline retries.
  localId Int? @map("local_id")

  /// Persistent till identity makes local integer ids safe across devices.
  deviceId String @default("legacy") @map("device_id")

  staffId String @map("staff_id")

  staffName String @map("staff_name")

  /// Buyer identity captured on the sale document, not read from a mutable
  /// customer directory during a later offline retry.
  buyerName String? @map("buyer_name")
  buyerTin  String? @map("buyer_tin")

  paymentMethod String @default("cash") @map("payment_method")

  paymentReference String? @map("payment_reference")

  total     Decimal  @default(0)
  profit    Decimal  @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  profile      Profile?      @relation("ProfileSales", fields: [staffId], references: [id])
  items        SaleItem[]
  salePayments SalePayment[]

  @@unique([tenantId, deviceId, localId])
  @@index([tenantId])
  @@index([createdAt])
  @@map("sales")
}

/// The append-only tender ledger for an offline sale. Keeping this separate
/// from Sale.paymentMethod preserves the legacy summary while allowing a
/// split sale to remain visible in multishop payment-mix reports.
model SalePayment {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  saleId    String   @map("sale_id")
  localUuid String   @map("local_uuid")
  method    String
  amount    Decimal
  tendered  Decimal?
  change    Decimal?
  reference String?
  status    String   @default("confirmed")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, localUuid])
  @@index([tenantId, saleId])
  @@map("sale_payments")
}

model SaleItem {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  saleId String @map("sale_id")

  productId String? @map("product_id")

  productName String @map("product_name")

  qty       Decimal
  unitPrice Decimal @map("unit_price")

  unitCost Decimal @map("unit_cost")

  // Snapshots from the till. Nullable keeps legacy uploads readable; reports
  // fall back to the historical gross line amount when these are absent.
  vatAmount      Decimal? @map("vat_amount")
  taxableAmount  Decimal? @map("taxable_amount")
  taxClass       String?  @map("tax_class")
  vatRateBps     Int?     @map("vat_rate_bps")
  taxRuleId      String?  @map("tax_rule_id")
  taxRuleVersion Int?     @map("tax_rule_version")

  portion   String @default("full")
  portionMl Int    @default(0) @map("portion_ml")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  sale    Sale     @relation(fields: [saleId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
  taxRule TaxRule? @relation(fields: [taxRuleId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([saleId])
  @@index([taxRuleId])
  @@map("sale_items")
}

model StockAdjustment {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  productId String @map("product_id")

  delta   Decimal
  reason  String?
  staffId String? @map("staff_id")

  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  product Product  @relation(fields: [productId], references: [id])
  profile Profile? @relation("ProfileStockAdjustments", fields: [staffId], references: [id])

  @@index([tenantId])
  @@map("stock_adjustments")
}

model Payment {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  initiatedBy String @map("initiated_by")

  staffName String @map("staff_name")

  reference   String @unique
  phoneNumber String @map("phone_number")

  amount       Decimal
  cartSnapshot Json    @map("cart_snapshot")

  status            String  @default("QUEUED")
  checkoutRequestId String? @map("checkout_request_id")

  saleId String? @map("sale_id")

  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  profile Profile? @relation("ProfilePayments", fields: [initiatedBy], references: [id])

  @@index([tenantId])
  @@index([reference])
  @@map("payments")
}

model DeletionLedger {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  subjectType String @map("subject_type")

  subjectId String @map("subject_id")

  reason      String?
  completedAt DateTime @default(now()) @map("completed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("deletion_ledgers")
}

// ---------------------------------------------------------------------------
// New models for integrated features
// ---------------------------------------------------------------------------

model VerificationChallenge {
  id       String  @id @default(cuid())
  tenantId String? @map("tenant_id")

  email     String
  code      String
  expiresAt DateTime @map("expires_at")

  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([email])
  @@index([code])
  @@index([expiresAt])
  @@map("verification_challenges")
}

model AppSession {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  accessToken String @map("access_token")

  refreshToken String @unique @map("refresh_token")

  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([refreshToken])
  @@index([expiresAt])
  @@map("app_sessions")
}

model EtimsDevice {
  id       String @id @default(cuid())
  tenantId String @unique @map("tenant_id")

  tin      String
  deviceId String @unique @map("device_id")

  deviceName String? @map("device_name")

  deviceSerial String? @map("device_serial")

  status    String  @default("unregistered") // active | unregistered
  accessKey String? @map("access_key")

  encryptionKey String? @map("encryption_key")

  initialisedAt DateTime? @map("initialised_at")

  lastError String? @map("last_error")

  registeredAt DateTime @default(now()) @map("registered_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  etimsReceipts EtimsReceipt[]
  etimsZReports EtimsZReport[]

  @@index([tenantId])
  @@index([deviceId])
  @@map("etims_devices")
}

model EtimsReceipt {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  // The till's own receipt number; unique per tenant so a duplicate upload is a no-op.
  receiptNumber String @map("receipt_number")

  kraReceiptNumber String? @unique @map("kra_receipt_number")

  verificationUrl String? @map("verification_url")

  qrPayload String? @map("qr_payload")

  status       String @default("pending") // pending | issued | rejected
  // A sale queues an invoice; a return queues a credit note against the
  // SAME table, on its own number series. The note carries the invoice it
  // reverses, because that is the KRA-side key.
  documentType String @default("invoice") // invoice | credit_note@map("document_type")

  originalReceiptNumber String? @map("original_receipt_number")

  returnNumber String? @map("return_number")

  payload  Json
  total    String?
  vatTotal String? @map("vat_total")

  vatRatePercent Float? @map("vat_rate_percent")

  itemCount Int? @map("item_count")

  paymentMethod String? @map("payment_method")

  paymentReference String? @map("payment_reference")

  rejectionReason String? @map("rejection_reason")

  deviceId String? @map("device_id")

  issuedAt DateTime? @map("issued_at")

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  device EtimsDevice? @relation(fields: [deviceId], references: [id])

  @@unique([tenantId, receiptNumber])
  @@unique([tenantId, returnNumber])
  @@index([tenantId])
  @@index([kraReceiptNumber])
  @@index([deviceId])
  @@index([status])
  @@index([createdAt])
  @@map("etims_receipts")
}

/// The end-of-day Z report, upserted per business date so a re-run replaces the
/// same day instead of minting a second Z number for it.
model EtimsZReport {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  deviceId String? @map("device_id")

  zNumber Int @map("z_number")

  businessDate DateTime @map("business_date")

  invoiceCount Int @default(0) @map("invoice_count")

  total    String @default("0.00")
  vatTotal String @default("0.00") @map("vat_total")

  pendingCount Int @default(0) @map("pending_count")

  rejectedCount Int @default(0) @map("rejected_count")

  status        String  @default("issued") // issued | failed
  failureReason String? @map("failure_reason")

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  device EtimsDevice? @relation(fields: [deviceId], references: [id])

  @@unique([tenantId, businessDate])
  @@index([tenantId])
  @@index([businessDate])
  @@map("etims_z_reports")
}

// ---------------------------------------------------------------------------
// Systems admin + churn analytics (new in v2.1)
// ---------------------------------------------------------------------------

/// Raw telemetry event pushed from a till phone. Never contains secrets/PII
/// (rule 3 of TelemetryService: route names, feature names, timestamps only).
model TelemetryEvent {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  deviceId String? // phone device identifier@map("device_id")

  name      String // app_open | app_close | screen_view | feature_use | sale_recorded | idle_start | idle_end
  at        DateTime @default(now()) // when the event occurred on the device, UTC
  route     String?
  detail    String? // non-user-controlled identifier only
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation("TenantTelemetryEvents", fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([name])
  @@index([at])
  @@index([createdAt])
  @@map("telemetry_events")
}

/// Pre-computed churn snapshot pushed from a till phone (phone computes the
/// ChurnAnalysis locally; backend only stores/delivers the snapshot).
model ChurnSnapshot {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  deviceId String? @map("device_id")

  date       DateTime // calendar date this snapshot describes
  streakDays Int      @map("streak_days")

  daysSinceLastActive Int @map("days_since_last_active")

  totalSessions Int @map("total_sessions")

  risk       String // none | low | medium | high
  score      Float // 0.0 to 1.0
  computedAt DateTime @default(now()) @map("computed_at")

  tenant Tenant @relation("TenantChurnSnapshots", fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([date])
  @@index([computedAt])
  @@map("churn_snapshots")
}

/// Audit log of systems-admin actions (global admin viewing/editing any tenant).
model AdminAuditLog {
  id      String @id @default(cuid())
  adminId String // profile id of the system admin who acted@map("admin_id")

  action     String // e.g. view_churn, update_tenant_settings, purge_telemetry
  targetType String? // e.g. tenant, sale, profile, telemetry_event@map("target_type")

  targetId String? @map("target_id")

  tenantId String? // which tenant was affected; null for cross-tenant actions@map("tenant_id")

  at DateTime @default(now())

  @@index([adminId])
  @@index([tenantId])
  @@index([at])
  @@map("admin_audit_logs")
}

/// A till phone's failure report, pushed from the app so system admins can
/// see what broke, on what phone, under what conditions. One row per device
/// that has reported; crashes are nested under it.
model DeviceDiagnostic {
  id        String @id @default(cuid()) @map("id")
  tenantId  String? @map("tenant_id")

  /// Stable device identifier, generated on first report and persisted on the
  /// phone so re-reports merge into the same device row.
  deviceId  String @map("device_id")
  platform  String // android | ios | ...
  osVersion String
  appVersion String
  buildNumber String
  locale    String
  manufacturer String?
  model     String?

  crashCount Int @default(0)
  errorCount Int @default(0)
  warningCount Int @default(0)

  firstSeen  DateTime @default(now()) @map("first_seen")
  lastSeen   DateTime @updatedAt @map("last_seen")

  crashes    DeviceCrashEntry[] @relation("DeviceCrashes")

  tenant     Tenant? @relation(fields: [tenantId], references: [id])

  @@index([deviceId])
  @@index([tenantId])
  @@index([lastSeen])
  @@map("device_diagnostics")
}

/// One failure entry inside a device diagnostic report.
model DeviceCrashEntry {
  id          String @id @default(cuid()) @map("id")
  diagnosticId String @map("diagnostic_id")

  kind        String // crash | error | warning
  message     String
  stack       String?
  route       String?
  actorName   String?
  action      String?
  breadcrumbs String? // newline-joined

  createdAt   DateTime @default(now()) @map("created_at")

  diagnostic  DeviceDiagnostic @relation("DeviceCrashes", fields: [diagnosticId], references: [id])

  @@index([diagnosticId])
  @@index([createdAt])
  @@map("device_crash_entries")
}

/// Platform-wide settings key/value store.
model SystemSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([key])
  @@map("system_settings")
}

/// Support ticket or feature request pushed from a till phone.
model SupportTicket {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  deviceId String? @map("device_id")

  type        String // ticket | request
  title       String
  description String
  status      String // open | in_progress | resolved
  createdAt   DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("support_tickets")
}

/// Fashion product variant (size/colour/SKU) synced from offline tills.
/// A variant belongs to a Product and is the unit that is actually sold.
model ProductVariant {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  /// The till's local variant id is the idempotency key for offline retries.
  localId Int? @map("local_id")

  /// Stable client key makes a retried offline variant create idempotent.
  syncKey  String? @map("sync_key")

  /// Backend-assigned opaque id; the till stores this to reference the variant
  /// in later syncs (e.g. stock movements, sale items).
  remoteId String? @map("remote_id")

  productId   String   @map("product_id")
  name        String   @map("variant_name")
  sku         String   @map("sku")
  unit        String   @default("each") @map("unit")
  sizeMl      Int      @default(0) @map("size_ml")
  sellPrice   Decimal  @default(0) @map("sell_price")
  costPrice   Decimal  @default(0) @map("cost_price")
  stockQty    Decimal  @default(0) @map("stock_qty")
  reservedQty Decimal  @default(0) @map("reserved_qty")
  reorderLevel Int      @default(0) @map("reorder_level")
  position    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([tenantId, syncKey])
  @@unique([tenantId, productId, localId])
  @@index([tenantId])
  @@index([productId])
  @@map("product_variants")
}

/// Open profile job (service work order) synced from an offline till.
model Job {
  id          String @id @default(cuid())
  tenantId    String @map("tenant_id")

  /// The till's local job id is the idempotency key for offline retries.
  localId Int? @map("local_id")

  /// Stable client key makes a retried offline job create idempotent.
  syncKey  String? @map("sync_key")

  /// Backend-assigned opaque id; the till stores this to reference the job in
  /// later syncs (e.g. job costs, job payments, cost pools).
  remoteId String? @map("remote_id")

  uuid         String   @map("uuid")
  title        String
  customerName String?  @map("customer_name")
  customerPhone String? @map("customer_phone")
  quoteMinor   Int      @default(0) @map("quote_minor")
  finalPriceMinor Int?   @map("final_price_minor")
  status       String   @default("draft") @map("status") // draft | awaiting_payment | completed | closed | cancelled
  dueAt        DateTime? @map("due_at")
  costPoolId   String? @map("cost_pool_id")
  staffId      String   @map("staff_id")
  staffName    String   @map("staff_name")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  jobCosts   JobCost[]
  jobPayments JobPayment[]

  @@unique([tenantId, syncKey])
  @@unique([tenantId, uuid])
  @@index([tenantId])
  @@index([status])
  @@index([costPoolId])
  @@map("jobs")
}

/// Open profile cost pool for shared cost recovery across job sales.
model CostPool {
  id          String @id @default(cuid())
  tenantId    String @map("tenant_id")

  /// The till's local cost pool id is the idempotency key for offline retries.
  localId Int? @map("local_id")

  /// Stable client key makes a retried offline cost pool create idempotent.
  syncKey  String? @map("sync_key")

  /// Backend-assigned opaque id.
  remoteId String? @map("remote_id")

  uuid           String   @map("uuid")
  name           String
  poolType       String   @default("lot") @map("pool_type") // lot | hourly | percentage
  investedMinor  Int      @default(0) @map("invested_minor")
  recoveredMinor Int      @default(0) @map("recovered_minor")
  status         String   @default("open") @map("status") // open | closed | cancelled
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, syncKey])
  @@unique([tenantId, uuid])
  @@index([tenantId])
  @@index([status])
  @@map("cost_pools")
}

/// Open profile job cost (materials/transport/helper) synced from an offline till.
model JobCost {
  id          String @id @default(cuid())
  tenantId    String @map("tenant_id")

  /// The till's local cost id is the idempotency key for offline retries.
  localId Int? @map("local_id")

  /// Stable client key makes a retried offline job cost create idempotent.
  syncKey  String? @map("sync_key")

  /// Backend-assigned opaque id.
  remoteId String? @map("remote_id")

  uuid          String   @map("uuid")
  jobId         String   @map("job_id")
  type          String   @map("type") // materials | transport | helper | other
  amountMinor   Int      @map("amount_minor")
  paymentMethod String   @default("cash") @map("payment_method")
  reference     String? @map("reference")
  staffId       String? @map("staff_id")
  staffName     String? @map("staff_name")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([tenantId, syncKey])
  @@unique([tenantId, jobId, localId])
  @@index([tenantId])
  @@index([jobId])
  @@map("job_costs")
}

/// Open profile job payment (deposit / balance / partial) synced from an offline till.
model JobPayment {
  id          String @id @default(cuid())
  tenantId    String @map("tenant_id")

  /// The till's local payment id is the idempotency key for offline retries.
  localId Int? @map("local_id")

  /// Stable client key makes a retried offline job payment create idempotent.
  syncKey  String? @map("sync_key")

  /// Backend-assigned opaque id.
  remoteId String? @map("remote_id")

  uuid          String   @map("uuid")
  jobId         String   @map("job_id")
  amountMinor   Int      @map("amount_minor")
  paymentMethod String   @map("payment_method") // cash | mpesa | bank_transfer | card
  reference     String? @map("reference")
  staffId       String? @map("staff_id")
  staffName     String? @map("staff_name")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([tenantId, syncKey])
  @@unique([tenantId, jobId, localId])
  @@index([tenantId])
  @@index([jobId])
  @@map("job_payments")
}

/// Open profile owner finance transaction (capital / drawing / loan / repayment).
model OwnerTransaction {
  id             String @id @default(cuid())
  tenantId       String @map("tenant_id")

  /// The till's local transaction id is the idempotency key for offline retries.
  localId Int? @map("local_id")

  /// Stable client key makes a retried offline owner transaction create idempotent.
  syncKey  String? @map("sync_key")

  /// Backend-assigned opaque id.
  remoteId String? @map("remote_id")

  uuid              String   @map("uuid")
  transactionType   String   @map("transaction_type") // capital_in | drawing | loan_received | loan_repayment
  amountMinor       Int      @map("amount_minor")
  shiftId           Int? @map("shift_id")
  staffId           String? @map("staff_id")
  staffName         String   @map("staff_name")
  note              String? @map("note")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, syncKey])
  @@unique([tenantId, uuid])
  @@index([tenantId])
  @@index([transactionType])
  @@index([createdAt])
  @@map("owner_transactions")
}

/// A customer's payment INTO the shop's Till or Paybill, seen by the server.
///
/// Created by the Daraja C2B confirmation callback, idempotent by the M-Pesa
/// transaction code (the callbacks arrive more than once and out of order,
/// and two till phones must not disagree about whether money arrived). The
/// payer is masked HERE, at the source: the device never holds a full paying
/// phone number, so a till cannot leak what it never received.
model MpesaIncoming {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  // The server's own id, which the devices page by, uniquely.
  remoteId String @unique @map("remote_id")

  // M-Pesa's transaction code, unique GLOBALLY on the network — two shops
  // cannot collide, so the uniqueness pays for itself in races.
  transId String @unique @map("trans_id")

  amount     Float
  // Masked at the callback: a first name and the last three digits.
  payerLabel String @map("payer_label")

  billRef String? @map("bill_ref")

  receivedAt DateTime @map("received_at")

  createdAt DateTime @default(now()) @map("created_at")

  // unclaimed | claimed | ignored | expired
  status          String  @default("unclaimed")
  claimedByDevice String? @map("claimed_by_device")

  claimedSaleUuid String? @map("claimed_sale_uuid")

  claimedAt DateTime? @map("claimed_at")

  ignoredAt DateTime? @map("ignored_at")

  ignoreReason String? @map("ignore_reason")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, receivedAt])
  @@index([status])
  @@map("mpesa_incoming")
}

/// The public receipt page's right to exist and to be withdrawn.
///
/// The token is the ONLY key — unguessable, revocable, expiring — and the
/// page renders the SNAPSHOT taken when the link was made (names, figures,
/// the QR), never a live query into the shop's documents.
model ReceiptLink {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  token     String   @unique
  // The receipt snapshot, as the page will show it.
  snapshot  Json
  createdAt DateTime @default(now()) @map("created_at")

  expiresAt DateTime @map("expires_at")

  revokedAt DateTime? @map("revoked_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([expiresAt])
  @@map("receipt_links")
}
