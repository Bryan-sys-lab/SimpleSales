// Prisma schema translating your existing Supabase SQL schema
// Maintains same multi-tenant structure with RLS concepts enforced in app code

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Your existing tables from 0001_schema.sql

enum UserRole {
  admin
  manager
  cashier
}

model Tenant {
  id                  String   @id @default(uuid())
  shopName            String   @map("shop_name")
  createdAt           DateTime @default(now()) @map("created_at")
  mpesaEnabled        Boolean  @default(false) @map("mpesa_enabled")
  etimsEnabled        Boolean  @default(false) @map("etims_enabled")
  payheroChannelId    Int?     @map("payhero_channel_id")
  payheroCredentialId String?  @map("payhero_credential_id")

  profiles         Profile[]
  products         Product[]
  sales            Sale[]
  stockAdjustments StockAdjustment[]
  payments         Payment[]
  deletionLedgers  DeletionLedger[]
  etimsDevice      EtimsDevice?
  etimsReceipts    EtimsReceipt[]
  etimsZReports    EtimsZReport[]
  emailVerifications EmailVerification[]

  @@map("tenants")
}

model Profile {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  oidcSubject String?   @map("oidc_subject")
  localId     Int?      @map("local_id")
  email       String?
  name        String
  role        UserRole  @default(cashier)
  active      Boolean   @default(true)
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  /// When the emailed 6-digit code for this address was presented. The outcome
  /// of verification lives here; the pending code never does — see
  /// `EmailVerification`. Null means "not verified", which is the state every
  /// other row in this table starts in.
  emailVerifiedAt DateTime? @map("email_verified_at")

  /// The hash of the shop's current app-session refresh token, and its expiry.
  /// A hash rather than the token, so a dumped database cannot be used to
  /// refresh a session; rotated on every use, so a stolen token works once.
  refreshTokenHash       String?   @unique @map("refresh_token_hash")
  refreshTokenExpiresAt  DateTime? @map("refresh_token_expires_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales            Sale[]
  stockAdjustments StockAdjustment[]
  payments         Payment[]

  @@unique([tenantId, localId])
  @@index([tenantId])
  @@index([oidcSubject])
  @@map("profiles")
}

/// A pending email-verification code: the only place one exists.
///
/// Not columns on `tenants` — a challenge is a short-lived, single-use,
/// attempt-counted secret, and hanging a half-finished one off a shop's own
/// row is how a shop ends up "half verified" after a failed attempt. Nothing
/// here outlives ten minutes, and the tenant is untouched until a code is
/// actually presented.
model EmailVerification {
  id     String @id @default(uuid())
  /// Lower-cased by the route, never by the database, so every comparison in
  /// this table is an equality and no lookup depends on a collation.
  email  String
  /// The shop the challenge belongs to, when it is already known. Null for a
  /// first-ever link, when the tenant does not exist yet.
  tenantId String? @map("tenant_id")
  /// The Keycloak subject the account was created for. `activateUser` is
  /// called with this, so the challenge and the account it verifies cannot
  /// drift apart.
  subject String

  /// HMAC-SHA256 of the 6-digit code, keyed by the server's verification
  /// secret and salted per row. A code is never stored in the clear.
  codeHash String    @map("code_hash")
  /// The same transform applied to the 4-digit admin PIN, under the same salt:
  /// the PIN binds the two halves of the flow to the same person, so it is
  /// compared by the same constant-time path rather than trusted.
  pinHash  String    @map("pin_hash")
  salt     String
  /// Failed attempts. Five burns the code; the row is then consumed and the
  /// owner asks for a new one.
  attempts Int       @default(0)
  /// Set the moment the code is used, superseded, or burnt. Everything that
  /// reads this table asks for `consumed_at IS NULL`, so consuming a row is
  /// the only way to invalidate a code.
  consumedAt DateTime? @map("consumed_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([email, createdAt])
  @@map("email_verifications")
}

model Product {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  name             String
  category         String   @default("General")
  costPrice        Decimal  @map("cost_price") @db.Decimal(12, 2)
  sellPrice        Decimal  @map("sell_price") @db.Decimal(12, 2)
  stockQty         Decimal  @default(0) @map("stock_qty") @db.Decimal(12, 3)
  reorderLevel     Int      @default(5) @map("reorder_level")
  bottleMl         Int      @default(750) @map("bottle_ml")
  halfPrice        Decimal? @map("half_price") @db.Decimal(12, 2)
  quarterPrice     Decimal? @map("quarter_price") @db.Decimal(12, 2)
  exciseStampBatch String?  @map("excise_stamp_batch")
  active           Boolean  @default(true)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleItems        SaleItem[]
  stockAdjustments StockAdjustment[]

  @@index([tenantId])
  @@map("products")
}

model Sale {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  staffId          String   @map("staff_id")
  staffName        String   @map("staff_name")
  paymentMethod    String   @default("cash") @map("payment_method")
  paymentReference String?  @map("payment_reference")
  total            Decimal  @db.Decimal(12, 2)
  profit           Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff     Profile    @relation(fields: [staffId], references: [id])
  saleItems SaleItem[]
  payment   Payment?

  @@index([tenantId, createdAt])
  @@map("sales")
}

model SaleItem {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  saleId      String  @map("sale_id")
  productId   String  @map("product_id")
  productName String  @map("product_name")
  qty         Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  unitCost    Decimal @map("unit_cost") @db.Decimal(12, 2)
  portion     String  @default("full")
  portionMl   Int     @default(0) @map("portion_ml")

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@map("sale_items")
}

model StockAdjustment {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  productId   String   @map("product_id")
  productName String   @map("product_name")
  delta       Int
  reason      String?
  staffId     String   @map("staff_id")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  staff   Profile @relation(fields: [staffId], references: [id])

  @@index([tenantId])
  @@map("stock_adjustments")
}

model Payment {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  initiatedBy       String   @map("initiated_by")
  staffName         String   @map("staff_name")
  reference         String   @unique
  checkoutRequestId String?  @map("checkout_request_id")
  phoneNumber       String   @map("phone_number")
  amount            Decimal  @db.Decimal(12, 2)
  status            String   @default("QUEUED")
  cartSnapshot      Json     @map("cart_snapshot")
  saleId            String?  @unique @map("sale_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  tenant             Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  initiatedByProfile Profile @relation(fields: [initiatedBy], references: [id])
  sale               Sale?   @relation(fields: [saleId], references: [id])

  @@index([tenantId])
  @@index([reference])
  @@map("payments")
}

model DeletionLedger {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  subjectType String    @map("subject_type")
  subjectId   String    @map("subject_id")
  reason      String?
  status      String    @default("COMPLETED")
  requestedAt DateTime  @default(now()) @map("requested_at")
  completedAt DateTime? @map("completed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, subjectType, subjectId])
  @@map("deletion_ledger")
}

// ============================================================================
// eTIMS (KRA electronic tax invoice)
// ============================================================================

/// A registered KRA eTIMS device for one shop.
///
/// One row per tenant. The credentials live here rather than in the environment
/// because one deployment serves many shops, each with its own TIN and its own
/// KRA account, and the OSCU signing key is issued per taxpayer. Keeping them
/// in env would mean one shop's receipts filed under another's TIN.
model EtimsDevice {
  id        String @id @default(uuid())
  tenantId  String @unique @map("tenant_id")
  tin       String
  deviceId  String @map("device_id")
  deviceName String @default("") @map("device_name")
  /// 'unregistered' | 'initialised' | 'active' | 'suspended'
  status    String @default("unregistered")
  /// Decrypted OSCU keys, base64. Never logged and never returned by an
  /// endpoint. `access_key` is the signing key KRA issued for this taxpayer.
  encryptionKey String? @map("encryption_key")
  accessKey     String? @map("access_key")
  /// The device serial KRA returns on initialisation. Required on re-init.
  deviceSerial  String? @map("device_serial")
  initialisedAt DateTime? @map("initialised_at")
  lastError     String? @map("last_error")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receipts EtimsReceipt[]
  zReports EtimsZReport[]

  @@map("etims_devices")
}

/// One tax invoice, exactly as KRA saw it.
///
/// An immutable ledger rather than a cache. The amounts arrive from the till
/// that actually took the money and are never recalculated here: a Z-report
/// built from a re-derived total would not reconcile against the paperwork the
/// customer was already handed.
model EtimsReceipt {
  id      String @id @default(uuid())
  tenantId String @map("tenant_id")
  deviceId String? @map("device_id")
  /// The till's own receipt number (`<TILL>-000123`). Unique per tenant, both
  /// because KRA rejects a duplicate submitted under the same device and number
  /// and because the till retries an upload it believes failed.
  receiptNumber String @map("receipt_number")
  /// KRA's receipt number. Null until issued. Deliberately not derivable from
  /// receiptNumber, so the two can disagree rather than one impersonating the
  /// other on a document.
  kraReceiptNumber String? @map("kra_receipt_number")
  /// The payload submitted to KRA, verbatim. Kept because KRA's own rules
  /// change, and a disputed invoice has to be reproducible exactly as sent.
  payload          Json
  /// Major-unit figures as Decimal, matching the rest of the catalogue so a
  /// float can never enter a tax document. The till sends integer minor units;
  /// routes/etims.ts converts at that boundary and nowhere else.
  total            Decimal   @db.Decimal(14, 2)
  vatTotal         Decimal   @db.Decimal(14, 2)
  vatRatePercent   Int       @default(16) @map("vat_rate_percent")
  itemCount        Int       @default(0) @map("item_count")
  paymentMethod    String    @default("cash") @map("payment_method")
  paymentReference String?   @map("payment_reference")
  /// 'pending' | 'issued' | 'rejected'
  status           String    @default("pending")
  /// Why KRA refused it, verbatim. Surfaced to the owner, because a silent
  /// refusal is an unissued tax invoice that nobody knows exists.
  rejectionReason  String?   @map("rejection_reason")
  issuedAt         DateTime? @map("issued_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device EtimsDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([tenantId, receiptNumber])
  // KRA receipt numbers are globally unique, and this index is what makes the
  // *public* verification page safe: it is looked up with no tenant filter,
  // because the person following the QR is a customer with no account.
  //
  // `receipt_number` cannot carry this guarantee — it is only unique per shop,
  // and "T1-000001" is a number several shops will independently reach.
  @@unique([kraReceiptNumber])
  @@index([tenantId, status])
  @@map("etims_receipts")
}

/// The end-of-day summary KRA requires.
///
/// Cumulative, never reset: an absolute Z-number starting at 1 is what an
/// auditor checks, and a per-day counter would let any day look like the shop's
/// first.
model EtimsZReport {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  deviceId    String?  @map("device_id")
  /// Absolute and monotonically increasing per device. This is the Z-number.
  zNumber     Int
  /// Business date covered, UTC midnight.
  businessDate DateTime @map("business_date")
  invoiceCount Int      @default(0) @map("invoice_count")
  total        Decimal  @db.Decimal(14, 2)
  vatTotal     Decimal  @db.Decimal(14, 2)
  /// Receipts the till recorded but KRA has not accepted. Reported on the
  /// Z-report because the gap between the two is precisely what KRA reconciles,
  /// and hiding it would make the report agree with itself while disagreeing
  /// with the authority.
  pendingCount  Int      @default(0) @map("pending_count")
  rejectedCount Int      @default(0) @map("rejected_count")
  status        String   @default("pending") // 'pending' | 'issued' | 'failed'
  failureReason String?  @map("failure_reason")
  rawResponse   Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device EtimsDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([tenantId, businessDate])
  @@index([tenantId, zNumber])
  @@map("etims_z_reports")
}
