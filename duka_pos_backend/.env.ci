# The stack's environment, for CI.
#
# Every value here is a throwaway for an ephemeral stack that lives for one
# CI run: the database is created fresh, the identity provider is started
# fresh, and the whole thing is torn down at the end. There is nothing
# secret in this file, which is why it is committed rather than kept in the
# repository's secret store.
#
# The stack reads its secrets from the environment — see docker-compose.yml —
# and this file is what supplies them.
#
# The admin PIN is SIX digits, and the Keycloak password is that same PIN:
# the owner's admin PIN IS the password on their online account.
POSTGRES_USER=duka_pos
POSTGRES_PASSWORD=ci_duka_pos_password
POSTGRES_DB=duka_pos
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=ci_keycloak_db_password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=ci_keycloak_admin_password
REALM_NAME=duka
CLIENT_ID=duka-app
TEST_USER=test-user
TEST_USER_PASSWORD=ci_test_user_password
TEST_USER_EMAIL=test-user@example.com
PAYHERO_AUTH_TOKEN=Basic Y2lfcGF5aGVyby10b2tlbg==
SYSTEM_ADMIN_SUBJECTS=ci-admin-subject
FRONTEND_URL=http://localhost:3000

# The verify flow's own secrets, so the flow is EXERCISED rather than
# answering 503. The email itself is not sent: VERIFICATION_DEBUG_CODES puts
# the code in the response instead, which is what the smoke test reads.
EMAIL_VERIFICATION_SECRET=ci_email_verification_secret_of_32_bytes_long
KEYCLOAK_ADMIN_CLIENT_ID=ci-admin-client
KEYCLOAK_ADMIN_CLIENT_SECRET=ci-admin-client-secret
KEYCLOAK_REALM=duka
KEYCLOAK_BASE_URL=http://keycloak:8080
VERIFICATION_DEBUG_CODES=true
APP_NAME=SimpleSales
