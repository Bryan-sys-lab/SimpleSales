{
  "info": {
    "name": "Duka POS backend — end to end",
    "description": "The whole flow, against a live stack, with a real Keycloak token.\n\nIt is the end-to-end story of one shop being created and used:\n\n  1. the owner asks for a code — the account is created in Keycloak, dark;\n  2. the code comes back — the account is activated and the shop is linked;\n  3. the owner signs in to KEYCLOAK with their email and their 6-digit admin PIN\n     (the PIN IS the password — there is no second secret to remember);\n  4. the till pushes its ledger, its drawer, a return, a delivery and a shot cup;\n  5. the reports answer with the shop's own figures.\n\nStep 3 is the part that makes this collection worth running: it is the only\nplace the whole credential story is exercised, from the emailed code to a\nbearer token the API accepts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 — the owner asks for a code",
      "item": [
        {
          "name": "POST /api/auth/link",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{owner_email}}\",\n  \"pin\": \"{{owner_pin}}\",\n  \"shopName\": \"E2E Test Shop\",\n  \"ownerName\": \"E2E Owner\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/link", "host": ["{{base_url}}"], "path": ["api", "auth", "link"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('The account was created in Keycloak, dark', function () {",
                  "  pm.expect(pm.response.json().status).to.eql('code_sent');",
                  "});",
                  "pm.test('The code comes back with the response in this build', function () {",
                  "  var code = pm.response.json().debug_code;",
                  "  pm.expect(code, 'the stack runs with VERIFICATION_DEBUG_CODES').to.be.a('string');",
                  "  pm.environment.set('owner_code', code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 — the code comes back",
      "item": [
        {
          "name": "POST /api/auth/verify",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{owner_email}}\",\n  \"pin\": \"{{owner_pin}}\",\n  \"code\": \"{{owner_code}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/verify", "host": ["{{base_url}}"], "path": ["api", "auth", "verify"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('The shop is linked', function () {",
                  "  var body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('verified');",
                  "  pm.expect(body.tenant_id).to.be.a('string').and.not.empty;",
                  "  pm.environment.set('tenant_id', body.tenant_id);",
                  "});",
                  "pm.test('And it mints NO token of its own', function () {",
                  "  var body = pm.response.json();",
                  "  pm.expect(body.access_token).to.be.undefined;",
                  "  pm.expect(body.sign_in_required).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 — the owner signs in to Keycloak",
      "item": [
        {
          "name": "POST the realm's token endpoint",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "raw",
              "raw": "grant_type=password&client_id={{keycloak_client_id}}&username={{owner_email}}&password={{owner_pin}}"
            },
            "url": { "raw": "{{keycloak_url}}/realms/{{keycloak_realm}}/protocol/openid-connect/token", "host": ["{{keycloak_url}}"], "path": ["realms", "{{keycloak_realm}}", "protocol", "openid-connect", "token"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('The admin PIN IS the password', function () {",
                  "  var body = pm.response.json();",
                  "  pm.expect(body.access_token, 'the owner signed in with their 6-digit PIN').to.be.a('string').and.not.empty;",
                  "  pm.environment.set('access_token', body.access_token);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4 — the till pushes its records",
      "item": [
        {
          "name": "POST /api/sales/sync — the ledger",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "x-tenant-id", "value": "{{tenant_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sales\": [\n    {\n      \"localId\": 1,\n      \"staffName\": \"E2E Owner\",\n      \"paymentMethod\": \"cash\",\n      \"total\": 10000,\n      \"profit\": 4000,\n      \"createdAt\": \"2026-01-01T00:00:00.000Z\",\n      \"items\": [\n        { \"productName\": \"Test Beer\", \"qty\": 1, \"unitPrice\": 10000, \"unitCost\": 6000, \"portion\": \"full\", \"portionMl\": 0 }\n      ]\n    }\n  ]"
            },
            "url": { "raw": "{{base_url}}/api/sales/sync", "host": ["{{base_url}}"], "path": ["api", "sales", "sync"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('The sale is confirmed, with a remote id', function () {",
                  "  var synced = pm.response.json().synced;",
                  "  pm.expect(synced).to.be.an('array').with.lengthOf(1);",
                  "  pm.expect(synced[0].remoteId).to.be.a('string').and.not.empty;",
                  "  pm.environment.set('first_remote_id', synced[0].remoteId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/sales/sync — the SAME sale again, and it is not doubled",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "x-tenant-id", "value": "{{tenant_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sales\": [\n    {\n      \"localId\": 1,\n      \"staffName\": \"E2E Owner\",\n      \"paymentMethod\": \"cash\",\n      \"total\": 10000,\n      \"profit\": 4000,\n      \"createdAt\": \"2026-01-01T00:00:00.000Z\",\n      \"items\": [\n        { \"productName\": \"Test Beer\", \"qty\": 1, \"unitPrice\": 10000, \"unitCost\": 6000, \"portion\": \"full\", \"portionMl\": 0 }\n      ]\n    }\n  ]"
            },
            "url": { "raw": "{{base_url}}/api/sales/sync", "host": ["{{base_url}}"], "path": ["api", "sales", "sync"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('The same remote id comes back', function () {",
                  "  var synced = pm.response.json().synced;",
                  "  pm.expect(synced[0].remoteId).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('And it is the SAME remote id, so the ledger did not double', function () {",
                  "  pm.expect(pm.response.json().synced[0].remoteId).to.eql(pm.environment.get('first_remote_id'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/shifts/sync — the drawer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "x-tenant-id", "value": "{{tenant_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shifts\": [\n    {\n      \"localId\": 1,\n      \"staffName\": \"E2E Owner\",\n      \"startTime\": \"2026-01-01T08:00:00.000Z\",\n      \"endTime\": \"2026-01-01T18:00:00.000Z\",\n      \"startFloat\": 100000,\n      \"endFloat\": 95000,\n      \"expectedCash\": 100000,\n      \"countedCash\": 95000,\n      \"status\": \"closed\"\n    }\n  ]"
            },
            "url": { "raw": "{{base_url}}/api/shifts/sync", "host": ["{{base_url}}"], "path": ["api", "shifts", "sync"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('The shift is confirmed', function () {",
                  "  pm.expect(pm.response.json().synced[0].remoteId).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/returns — a return, in minor units",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "x-tenant-id", "value": "{{tenant_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"localId\": 1,\n  \"kind\": \"refund\",\n  \"reason\": \"The customer changed their mind\",\n  \"total\": 5000,\n  \"profit\": 3000,\n  \"staffName\": \"E2E Owner\",\n  \"createdAt\": \"2026-01-01T12:00:00.000Z\",\n  \"items\": [\n    { \"productName\": \"Test Beer\", \"qty\": 1, \"unitPrice\": 5000, \"unitCost\": 3000, \"portion\": \"full\", \"portionMl\": 0 }\n  ]"
            },
            "url": { "raw": "{{base_url}}/api/returns", "host": ["{{base_url}}"], "path": ["api", "returns"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('The return is confirmed', function () {",
                  "  pm.expect(pm.response.json().returnId).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/purchases — a delivery, and what it cost",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "x-tenant-id", "value": "{{tenant_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"localId\": 1,\n  \"supplierName\": \"Kentex\",\n  \"invoiceNumber\": \"INV-1\",\n  \"total\": 54000,\n  \"staffName\": \"E2E Owner\",\n  \"createdAt\": \"2026-01-02T08:00:00.000Z\",\n  \"items\": [\n    { \"productName\": \"Test Beer\", \"qty\": 12, \"unitCost\": 9000 }\n  ]"
            },
            "url": { "raw": "{{base_url}}/api/purchases", "host": ["{{base_url}}"], "path": ["api", "purchases"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('The delivery is confirmed', function () {",
                  "  pm.expect(pm.response.json().purchaseId).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/shot-cups/sync — a cup with NO size",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "x-tenant-id", "value": "{{tenant_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shotCups\": [\n    { \"localId\": 1, \"productName\": \"Test Beer\", \"label\": \"One shot\", \"capacityMl\": 0, \"price\": 5000, \"active\": true }\n  ]"
            },
            "url": { "raw": "{{base_url}}/api/shot-cups/sync", "host": ["{{base_url}}"], "path": ["api", "shot-cups", "sync"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('A cup with no size is a legal cup', function () {",
                  "  pm.expect(pm.response.json().synced[0].remoteId).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5 — the reports answer",
      "item": [
        {
          "name": "GET /api/tenant/portfolio — in the app's own shape",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "x-tenant-id", "value": "{{tenant_id}}" }
            ],
            "url": { "raw": "{{base_url}}/api/tenant/portfolio", "host": ["{{base_url}}"], "path": ["api", "tenant", "portfolio"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('It answers in the shape the app reads', function () {",
                  "  var body = pm.response.json();",
                  "  pm.expect(body).to.have.property('shops').and.to.be.an('array');",
                  "  if (body.shops.length) {",
                  "    var shop = body.shops[0];",
                  "    pm.expect(shop).to.have.property('tenantId');",
                  "    pm.expect(shop).to.have.property('shopName');",
                  "    pm.expect(shop).to.have.property('revenue').and.to.be.a('number');",
                  "    pm.expect(shop).to.have.property('profit').and.to.be.a('number');",
                  "    pm.expect(shop).to.have.property('transactions').and.to.be.a('number');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/shifts — the drawer, and the variance",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "x-tenant-id", "value": "{{tenant_id}}" }
            ],
            "url": { "raw": "{{base_url}}/api/shifts", "host": ["{{base_url}}"], "path": ["api", "shifts"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('It answers with the shifts and their totals', function () {",
                  "  var body = pm.response.json();",
                  "  pm.expect(body.shifts).to.be.an('array');",
                  "  pm.expect(body.totals).to.be.an('object');",
                  "  pm.expect(body.totals).to.have.property('variance').and.to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "keycloak_url", "value": "http://localhost:8080" },
    { "key": "keycloak_realm", "value": "duka" },
    { "key": "keycloak_client_id", "value": "duka-app" },
    { "key": "owner_email", "value": "owner@example.com" },
    { "key": "owner_pin", "value": "123456" }
  ]
}
