{
  "newman": {
    "timeout": 30000,
    "delay": 0,
    "color": "on"
  },
  "environments": {
    "local": {
      "base_url": "http://localhost:3000"
    },
    "docker": {
      "base_url": "http://backend:3000"
    },
    "ci": {
      "base_url": "http://localhost:3000"
    }
  },
  "reporters": ["cli", "html"],
  "reporter": {
    "html": {
      "export": "./newman-report.html",
      "template": "default"
    },
    "cli": {}
  }
}
