{
  "info": {
    "name": "Duka POS backend — smoke",
    "description": "The routes a person can reach WITHOUT a token.\n\nThis collection is a refusal test as much as a reachability test: it walks the endpoints that are GONE and asserts that they are gone, because a route that was removed and still answers is a route that was only half removed.\n\nIt runs against a live stack: `docker compose up -d --build`, then `npm run test:postman`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "The service is up",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('It says ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /ready — the database answers",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/ready", "host": ["{{base_url}}"], "path": ["ready"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('It says ready', function () { pm.expect(pm.response.json().status).to.eql('ready'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "The verify flow",
      "item": [
        {
          "name": "POST /api/auth/link — a good body",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{owner_email}}\",\n  \"pin\": \"{{owner_pin}}\",\n  \"shopName\": \"Smoke Test Shop\",\n  \"ownerName\": \"Smoke Owner\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/link", "host": ["{{base_url}}"], "path": ["api", "auth", "link"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('It has a challenge', function () { pm.expect(pm.response.json()).to.have.property('challenge_id'); });",
                  "pm.test('The address is MASKED, not echoed back', function () {",
                  "  var email = pm.response.json().email;",
                  "  pm.expect(email).to.be.a('string');",
                  "  pm.expect(email).to.not.include('@example.com');",
                  "});",
                  "pm.test('It says the code was sent', function () { pm.expect(pm.response.json().status).to.eql('code_sent'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/link — an invalid email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"not-an-email\",\n  \"pin\": \"{{owner_pin}}\",\n  \"shopName\": \"Smoke Test Shop\",\n  \"ownerName\": \"Smoke Owner\"\n}" },
            "url": { "raw": "{{base_url}}/api/auth/link", "host": ["{{base_url}}"], "path": ["api", "auth", "link"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/link — a FOUR-digit admin PIN is refused",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{owner_email}}\",\n  \"pin\": \"1234\",\n  \"shopName\": \"Smoke Test Shop\",\n  \"ownerName\": \"Smoke Owner\"\n}" },
            "url": { "raw": "{{base_url}}/api/auth/link", "host": ["{{base_url}}"], "path": ["api", "auth", "link"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('And it says the PIN is the wrong length', function () {",
                  "  var body = pm.response.text();",
                  "  pm.expect(body).to.include('6 digits');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/verify — a wrong code",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{owner_email}}\",\n  \"pin\": \"{{owner_pin}}\",\n  \"code\": \"000000\"\n}" },
            "url": { "raw": "{{base_url}}/api/auth/verify", "host": ["{{base_url}}"], "path": ["api", "auth", "verify"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('The code is what is wrong', function () {",
                  "  var code = pm.response.json().code;",
                  "  pm.expect(['VERIFICATION_INVALID', 'VERIFICATION_EXPIRED']).to.include(code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/verify — no code at all",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{owner_email}}\",\n  \"pin\": \"{{owner_pin}}\"\n}" },
            "url": { "raw": "{{base_url}}/api/auth/verify", "host": ["{{base_url}}"], "path": ["api", "auth", "verify"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "The endpoints that are gone",
      "item": [
        {
          "name": "POST /api/auth/refresh — there is no session of ours to refresh",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"not-a-real-refresh-token-at-all\"\n}" },
            "url": { "raw": "{{base_url}}/api/auth/refresh", "host": ["{{base_url}}"], "path": ["api", "auth", "refresh"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('It is not answered', function () {",
                  "  pm.expect([401, 404]).to.include(pm.response.code);",
                  "});",
                  "pm.test('And it mints no token', function () {",
                  "  var body = pm.response.json();",
                  "  pm.expect(body.access_token).to.be.undefined;",
                  "  pm.expect(body.refresh_token).to.be.undefined;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/pin-reset/request — the app recovers a PIN on the device",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{owner_email}}\"\n}" },
            "url": { "raw": "{{base_url}}/api/auth/pin-reset/request", "host": ["{{base_url}}"], "path": ["api", "auth", "pin-reset", "request"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('It is not answered', function () {",
                  "  pm.expect([401, 404]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/pin-reset/confirm — and there is no confirming either",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{owner_email}}\",\n  \"challengeId\": \"x\",\n  \"code\": \"000000\"\n}" },
            "url": { "raw": "{{base_url}}/api/auth/pin-reset/confirm", "host": ["{{base_url}}"], "path": ["api", "auth", "pin-reset", "confirm"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('It is not answered', function () {",
                  "  pm.expect([401, 404]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
