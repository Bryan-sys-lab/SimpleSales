{
  "name": "duka-pos-backend",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=26.0.0"
  },
  "description": "Duka POS backend API - shop management, sales, payments, eTIMS, updates",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run --no-file-parallelism --maxWorkers=1 --maxConcurrency=1",
    "test:live": "node scripts/live-smoke.mjs",
    "test:live:auth": "node scripts/auth-journey.mjs",
    "test:live:analytics": "node scripts/analytics-journey.mjs",
    "test:live:backup": "node scripts/backup-journey.mjs",
    "test:load": "node scripts/load-test.mjs",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@prisma/client": "^5.22.0",
    "body-parser": "^2.4.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-jwt": "^8.4.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jwks-rsa": "^4.1.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.0",
    "eslint": "^10.13.0",
    "prisma": "^5.22.0",
    "supertest": "^7.3.1",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
