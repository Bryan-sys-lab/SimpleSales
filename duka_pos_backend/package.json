{
  "name": "duka-pos-backend",
  "version": "1.0.0",
  "description": "Custom TypeScript backend for Duka POS - M-Pesa payments and multi-tenant API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/public', 'dist/public', {recursive: true})\"",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:roles": "prisma db execute --file prisma/ROLE_MIGRATION.sql",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test:postman": "npx --yes newman@6 run postman/duka-pos-backend.postman_collection.json --environment postman/newman-environment.json --reporters cli --bail",
    "test:postman:e2e": "npx --yes newman@6 run postman/duka-pos-e2e.postman_collection.json --environment postman/newman-environment.json --reporters cli --bail",
    "stack:up": "docker compose --env-file .env.ci up -d --build",
    "stack:down": "docker compose --env-file .env.ci down -v",
    "stack:logs": "docker compose --env-file .env.ci logs --no-color"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-jwt": "^8.4.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.7.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
